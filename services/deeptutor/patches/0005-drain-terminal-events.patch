+def _blueprint_question(item, ordinal, source_hash, parent=""):
+    qtype = _coerce_question_type(item.get("question_type"))
+    reference = str(item.get("question_text") or "").strip()
+    if not reference:
+        raise ValueError("Empty reference question")
+    identity = f"{source_hash}:{parent}:{ordinal}"
+    qid = "q_" + hashlib.sha256(identity.encode()).hexdigest()[:20]
+    keys = item.get("option_keys") or list(dict.fromkeys(re.findall(r"(?:^|[\s])([A-Z])[.、．)]\s*", reference)))
+    if qtype in {"choice", "multiple_choice"}:
+        keys = keys or ["A", "B", "C", "D"]  # Legacy extraction cache compatibility.
+        if not isinstance(keys, list) or len(keys) < 2 or len(set(keys)) != len(keys) or any(not isinstance(k, str) or not re.fullmatch(r"[A-Z]", k) for k in keys):
+            raise ValueError("Invalid source option keys")
+    else:
+        keys = []
+    blanks = item.get("blank_count") or max(1, len(re.findall(r"_{2,}|（\s*）|\(\s*\)", reference))) if qtype == "fill_in_blank" else 0
+    if type(blanks) is not int or blanks < 0:
+        raise ValueError("Invalid blank count")
+    raw_children = item.get("children") or []
+    if not isinstance(raw_children, list) or (qtype == "compound" and not raw_children) or (qtype != "compound" and raw_children):
+        raise ValueError("Invalid compound question structure")
+    children = [_blueprint_question(child, i, source_hash, qid) for i, child in enumerate(raw_children, 1)]
+    images = item.get("images") or []
+    if not isinstance(images, list) or any(not isinstance(name, str) for name in images):
+        raise ValueError("Invalid question images")
+    return {"question_id": qid, "source_hash": source_hash, "ordinal": ordinal,
+            "original_number": str(item.get("question_number") or ordinal),
+            "section": str(item.get("section") or ""), "question_type": qtype,
+            "concept": str(item.get("concept") or reference),
+            "source_text": str(item.get("source_text") or reference),
+            "reference_question": reference, "reference_answer": str(item.get("answer") or ""),
+            "option_keys": keys, "blank_count": blanks, "children": children,
+            "images": [Path(name).name if name.startswith("images/") else name for name in images],
+            "page_indices": item.get("page_indices") or [],
+            "source_start_line": item.get("source_start_line"), "source_end_line": item.get("source_end_line")}
