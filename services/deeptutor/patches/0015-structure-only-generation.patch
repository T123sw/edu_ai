index 0000000..97ee2ad
--- /dev/null
+++ b/deeptutor/agents/question/algorithm_checks.py
@@ -0,0 +1,153 @@
+"""Small deterministic algorithms for exam evidence; no generated code is executed."""
+import math
+
+
+def _size(value, maximum=1000):
+    if type(value) is not int or not 0 <= value <= maximum:
+        raise ValueError('invalid algorithm input size')
+
+
+def is_heap(sequence, minimum=True):
+    _size(len(sequence), 10000)
+    return all((sequence[(i-1)//2] <= sequence[i] if minimum else sequence[(i-1)//2] >= sequence[i]) for i in range(1,len(sequence)))
+
+
+def is_topological_order(vertices, edges, order):
+    _size(len(vertices)); _size(len(edges),10000)
+    if len(set(vertices)) != len(vertices) or len(order) != len(vertices) or set(order) != set(vertices): return False
+    positions = {v:i for i,v in enumerate(order)}
+    return all(u in positions and v in positions and positions[u]<positions[v] for u,v in edges)
+
+
+def linear_probe(keys, size, modulus=None, deleted=()):
+    """Integer keys, h(k)=k%modulus, linear wraparound; deleted slots remain tombstones.
+
+    successful_probes follows surviving keys' original insertion order.
+    unsuccessful_probes contains searches starting at each possible hash address.
+    """
+    _size(size,256)
+    if size == 0: raise ValueError('empty hash table')
+    modulus = size if modulus is None else modulus
+    _size(modulus,size)
+    if not modulus or len(keys)>size or len(set(keys))!=len(keys) or any(type(k) is not int for k in keys):
+        raise ValueError('invalid unique integer hash keys or modulus')
+    table=[None]*size; probes={}
+    for key in keys:
+        for step in range(size):
+            pos=(key%modulus+step)%size
+            if table[pos] is None: table[pos]=key;probes[key]=step+1;break
+    for key in deleted:
+        if key not in probes: raise ValueError('deleted key absent')
+        table[table.index(key)]='deleted';del probes[key]
+    unsuccessful=[]
+    for start in range(modulus):
+        count=0
+        for step in range(size):
+            count+=1
+            if table[(start+step)%size] is None: break
+        unsuccessful.append(count)
+    successful=list(probes.values())
+    return {'table':table,'successful_probes':successful,'unsuccessful_probes':unsuccessful,
+        'asl_success':sum(successful)/len(successful) if successful else None,
+        'asl_unsuccess':sum(unsuccessful)/modulus}
+
+
+def dijkstra(matrix, source, stop=None):
+    """None means absent edge; zero-weight edges allowed. Break equal distances by index.
+
+    trace records state immediately after settling, BEFORE relaxing outgoing edges.
+    The returned state for stop is also before relaxing that vertex. Strict '<'
+    updates preserve the first predecessor for equal-length paths; source P=-1.
+    """
+    n=len(matrix);_size(n,100)
+    if not n or any(len(row)!=n for row in matrix) or type(source) is not int or not 0<=source<n:
+        raise ValueError('invalid graph matrix/source')
+    if stop is not None and (type(stop) is not int or not 0<=stop<n):raise ValueError('invalid stop vertex')
+    if any(w is not None and (type(w) not in (int,float) or not math.isfinite(w) or w<0) for row in matrix for w in row):
+        raise ValueError('Dijkstra requires finite nonnegative weights; use a separate counterexample for negative edges')
+    distances=[None]*n;pred=[-1]*n;settled=[0]*n;order=[];trace=[];distances[source]=0
+    for _ in range(n):
+        choices=[i for i in range(n) if not settled[i] and distances[i] is not None]
+        if not choices:break
+        u=min(choices,key=lambda i:(distances[i],i));settled[u]=1;order.append(u)
+        state={'vertex':u,'settled':list(settled),'distances':list(distances),'predecessors':list(pred)}
+        trace.append(state)
+        if u==stop:break
+        for v,w in enumerate(matrix[u]):
+            if w is not None and not settled[v] and (distances[v] is None or distances[u]+w<distances[v]):
+                distances[v]=distances[u]+w;pred[v]=u
+    return {'settled':settled,'distances':distances,'predecessors':pred,'order':order,'trace':trace}
+
+
+ALGORITHM_GUIDE = '''
+Deterministic helpers (positional or named arguments; exact semantics below):
+is_heap(sequence, minimum=True) checks every parent/child; false means max-heap mode.
+is_topological_order(vertices, edges, order) checks a full permutation against every directed edge.
+linear_probe(keys, size, modulus=None, deleted=[]) uses h(k)=k%modulus (default size), linear wraparound;
+returns dict table, successful_probes (surviving insertion order), unsuccessful_probes (each starting address 0..modulus-1),
+asl_success, asl_unsuccess. Deletion leaves tombstones; unsuccessful search counts the first empty slot (or one full cycle).
+dijkstra(matrix, source, stop=None): None means absent edge, zero weights allowed, weights must be nonnegative;
+ties choose smaller vertex index, strict-less relaxation keeps first predecessor, P[source]=-1.
+Returns dict settled (0/1), distances (None unreachable), predecessors, order, trace.
+If stop is supplied, state is AFTER selecting stop but BEFORE relaxing its outgoing edges. Each trace has vertex and those arrays.
+Use checks that match the question's stated conventions; do not apply a helper to incompatible input or conventions.
+'''
+
+
+def complete_tree_facts(count, target, index_base=0):
+    """Compute level-order and spatial leaf order separately; never assume contiguous subtree labels."""
+    _size(count,10000)
+    if index_base not in (0,1) or type(target) is not int or not index_base<=target<count+index_base:
+        raise ValueError('invalid complete-tree target/index base')
+    target-=index_base
+    path=[target]
+    while path[-1]:path.append((path[-1]-1)//2)
+    path.reverse();root=path[1] if len(path)>1 else 0
+    nodes=[];leaves=[];pending=[(root,1)];height=0
+    while pending:
+        node,depth=pending.pop()
+        if node>=count:continue
+        nodes.append(node);height=max(height,depth)
+        if 2*node+1>=count:leaves.append(node)
+        else:pending.extend([(2*node+2,depth+1),(2*node+1,depth+1)])
+    # Inorder gives horizontal leaf order, including leaves in an internal
+    # target's left subtree. Preorder would incorrectly skip those leaves.
+    before=0;stack=[];node=root
+    while node<count or stack:
+        while node<count:
+            stack.append(node);node=2*node+1
+        node=stack.pop()
+        if node==target:break
+        if 2*node+1>=count:before+=1
+        node=2*node+2
+    return {'node_count':count,'index_base':index_base,'target':target+index_base,'path':[i+index_base for i in path],
+        'top_subtree_root':root+index_base,'top_subtree_side':'root' if root==0 else 'left' if root==1 else 'right',
+        'top_subtree_count':len(nodes),'top_subtree_height':height,'top_subtree_max_label':max(nodes)+index_base,
+        'target_is_leaf':target in leaves,'leaves_before_by_label':sum(i<target for i in leaves),
+        'leaves_to_left':before,'top_subtree_leaf_count':len(leaves)}
+
+ALGORITHM_GUIDE += '''
+complete_tree_facts(count, target, index_base=0) MUST be used for complete binary-tree node/leaf/subtree questions.
+Pass the EXACT node count, target label and indexing base from the candidate question. Returns:
+path, top_subtree_root/side/count/height/max_label, target_is_leaf, top_subtree_leaf_count,
+leaves_before_by_label (smaller global level-order labels) and leaves_to_left (spatial left-to-right).
+These two leaf counts can differ in an incomplete last level. Use the one explicitly asked; never substitute one for the other.
+The top subtree is the root's left or right subtree containing target, not a contiguous global label interval.
+'''
+
+
+def tree_instance_plan(count, target, index_base=0):
+    """A computed candidate instance for authors, including ancestor subtrees.
+
+    Values are chosen by the caller; no source-paper answers are embedded.
+    """
+    facts = complete_tree_facts(count, target, index_base)
+    subtrees = []
+    for label in facts['path'][-4:]:
+        root = label-index_base
+        levels=[];pending=[root]
+        while pending:
+            levels.append([i+index_base for i in pending])
+            pending=[child for i in pending for child in (2*i+1,2*i+2) if child<count]
+        subtrees.append({'root':label,'height':len(levels),'count':sum(map(len,levels)),'levels':levels})
+    return {'facts':facts,'ancestor_subtrees':subtrees}
diff --git a/deeptutor/agents/question/answer_evidence.py b/deeptutor/agents/question/answer_evidence.py
new file mode 100644
index 0000000..a9e1fcf
--- /dev/null
+++ b/deeptutor/agents/question/answer_evidence.py
@@ -0,0 +1,33 @@
+"""Build executable comparisons to the actual submitted answers, without source images."""
+import json
+from .calculation_check import CALCULATOR_GUIDE,check_calculations,check_tree_answer_assertions,tree_answer_claims
+
+
+async def verify_tree_answers(question, computed, call):
+    system='''Translate the supplied candidate answers and explanations into executable comparisons; do not rewrite or silently correct them.
+You receive independently computed tree facts. Return FINISH then JSON with ONLY the key calculations (an array).
+First bind helper results using name+expression (expected may be omitted). Then provide one or more comparisons for EVERY leaf child,
+tagged question_id (use root only if no id), expression, expected=true. Use the EXACT answer claimed in that child, even when wrong.
+Every child's answer comparison MUST derive from complete_tree_facts, complete_tree_subtree or complete_tree_path, directly or via named bindings. A range-based derivation or literal node array alone does not establish coverage. Tag the comparison with THAT child's exact question_id, not its sibling's id.
+For example, if the candidate claims 249 leaves, compare facts['leaves_to_left']==249, NOT a corrected value you prefer.
+Check explanations too: a claim that subtree labels form an interval requires comparing ALL actual nodes with that interval,
+not merely matching counts. Check every numerical/membership/height/leaf-order assertion. Do not invent new claims.
+For a drawn subtree compare the explicit node set and parent-child structure using the actual global labels.
+Do not trust solution prose or any unexecuted expected value. Spatial left-to-right leaf order differs from global level-order labels.
+Deduplicate shared explanation facts instead of checking identical prose repeatedly; at most 64 calculations. Do not return a verdict or commentary; only calculations. A failing comparison is useful evidence, not a reason to alter the candidate.
+''' + CALCULATOR_GUIDE
+    data={'candidate':question,'executed_facts':computed}
+    evidence=[];issues=[]
+    for attempt in range(2):
+        result=await call(system,json.dumps(data,ensure_ascii=False),attempt)
+        checks=result.get('calculations')
+        evidence,issues=check_calculations(checks,allow_compute_only=True)
+        coverage=check_tree_answer_assertions(evidence,question)
+        if not issues and not coverage:return evidence,[]
+        # If actual candidate comparisons are false, do not ask the checker to
+        # change them until true. Only malformed or missing evidence gets repaired.
+        if any(actual is False for _,actual in tree_answer_claims(evidence,question)[1]):
+            return evidence,['candidate_tree_claim_false',*issues,*coverage]
+        data={**data,'previous_checks':checks,'calculator_feedback':evidence,'errors':issues+coverage,
+              'instruction':'Fix the comparison expressions and missing child coverage. Keep the candidate and its claimed values unchanged. Use exact question_id fields.'}
+    return evidence,['tree_answer_unverified',*issues,*coverage]
diff --git a/deeptutor/agents/question/calculation_check.py b/deeptutor/agents/question/calculation_check.py
new file mode 100644
index 0000000..e427ecc
--- /dev/null
+++ b/deeptutor/agents/question/calculation_check.py
@@ -0,0 +1,365 @@
+"""Bounded arithmetic expressions for independent exam verification, never Python exec."""
+import ast
+import math
+import operator
+from .algorithm_checks import is_heap, is_topological_order, linear_probe, dijkstra, complete_tree_facts, ALGORITHM_GUIDE
+
+
+class CalculationError(ValueError):
+    pass
+
+
+def partition_hole(sequence):
+    a = list(sequence)
+    if not a: return a
+    pivot = a[0]; left = 0; right = len(a)-1
+    while left < right:
+        while left < right and a[right] >= pivot: right -= 1
+        a[left] = a[right]
+        while left < right and a[left] <= pivot: left += 1
+        a[right] = a[left]
+    a[left] = pivot
+    return a
+
+
+def partition_swap(sequence):
+    a = list(sequence)
+    if not a: return a
+    pivot = a[0]; left = 1; right = len(a)-1
+    while True:
+        while left <= right and a[left] <= pivot: left += 1
+        while left <= right and a[right] >= pivot: right -= 1
+        if left >= right: break
+        a[left], a[right] = a[right], a[left]
+        left += 1; right -= 1
+    a[0], a[right] = a[right], a[0]
+    return a
+
+
+def binary_search_trace(sequence, target):
+    lo, hi = 0, len(sequence)-1; trace = []
+    while lo <= hi:
+        mid = (lo+hi)//2; trace.append(mid)
+        if sequence[mid] == target: break
+        if sequence[mid] < target: lo = mid+1
+        else: hi = mid-1
+    return trace
+
+
+def complete_tree_path(index, index_base=0):
+    if type(index_base) is not int or index_base not in (0,1) or type(index) is not int or not index_base <= index <= 10**12:
+        raise CalculationError('invalid tree index/base')
+    index-=index_base
+    path = [index]
+    while index:
+        index = (index-1)//2; path.append(index)
+    return [i+index_base for i in path[::-1]]
+
+
+def complete_tree_subtree(count, root, index_base=0):
+    if type(index_base) is not int or index_base not in (0,1) or type(count) is not int or type(root) is not int or not 0 <= count <= 10000 or root < index_base:
+        raise CalculationError('invalid bounded complete tree/root/base')
+    pending, result = [root-index_base], []
+    while pending:
+        n = pending.pop()
+        if n >= count: continue
+        result.append(n+index_base); pending.extend([2*n+1,2*n+2])
+    return sorted(result)
+
+
+class Calculator:
+    def __init__(self):
+        self.steps = 0
+        self.materialized = 0
+
+    def bounded(self, value):
+        # Count nested helper results too: a short outer list can retain a very
+        # large matrix/trace. Stop traversing as soon as the budget is exceeded.
+        pending=[value]
+        while pending:
+            item=pending.pop()
+            if isinstance(item, complex):raise CalculationError('complex values not supported')
+            if isinstance(item,int) and item.bit_length()>4096:raise CalculationError('integer too large')
+            if isinstance(item,float) and not math.isfinite(item):raise CalculationError('non-finite result')
+            if isinstance(item,(list,tuple,set,dict,str)):
+                if len(item)>10000:raise CalculationError('result too large')
+                self.materialized+=len(item)
+                if self.materialized>200000:raise CalculationError('allocation budget exceeded')
+                if isinstance(item,dict):pending.extend(item.keys());pending.extend(item.values())
+                elif not isinstance(item,str):pending.extend(item)
+        return value
+
+    def evaluate(self, expression, bindings=None):
+        if not isinstance(expression, str) or len(expression) > 4000:
+            raise CalculationError('expression too long')
+        try:
+            return self.node(ast.parse(expression, mode='eval').body, dict(bindings or {}))
+        except (ArithmeticError, TypeError, IndexError, KeyError, SyntaxError) as exc:
+            raise CalculationError(type(exc).__name__) from None
+
+    def node(self, n, env):
+        self.steps += 1
+        if self.steps > 50000:
+            raise CalculationError('operation budget exceeded')
+        if isinstance(n, ast.Constant) and type(n.value) in (int, float, bool, str, type(None)):
+            return self.bounded(n.value)
+        if isinstance(n, ast.Name):
+            if n.id in env: return env[n.id]
+            if n.id in ('true','false','null'):return {'true':True,'false':False,'null':None}[n.id]
+            raise CalculationError('unknown variable: ' + n.id)
+        if isinstance(n, ast.Dict):
+            if any(k is None for k in n.keys): raise CalculationError('dict unpacking not allowed')
+            return self.bounded({self.node(k,env):self.node(v,env) for k,v in zip(n.keys,n.values)})
+        if isinstance(n, (ast.List, ast.Tuple)):
+            values = [self.node(v, env) for v in n.elts]
+            return self.bounded(values)
+        if isinstance(n, ast.UnaryOp):
+            op = {ast.USub: operator.neg, ast.UAdd: operator.pos, ast.Not: operator.not_}.get(type(n.op))
+            if op: return self.bounded(op(self.node(n.operand, env)))
+        if isinstance(n, ast.BinOp):
+            a, b = self.node(n.left, env), self.node(n.right, env)
+            if isinstance(n.op, ast.Add) and type(a) is type(b) and isinstance(a, (list, str)):
+                if len(a)+len(b)>10000: raise CalculationError('concatenation too large')
+                return self.bounded(a+b)
+            if not isinstance(a, (int, float)) or not isinstance(b, (int, float)):
+                raise CalculationError('only numeric binary operations allowed')
+            if isinstance(n.op, ast.Pow) and (abs(b) > 128 or abs(a) > 10**12):
+                raise CalculationError('power too large')
+            op = {ast.Add: operator.add, ast.Sub: operator.sub, ast.Mult: operator.mul,
+                  ast.Div: operator.truediv, ast.FloorDiv: operator.floordiv, ast.Mod: operator.mod,
+                  ast.Pow: operator.pow}.get(type(n.op))
+            if op: return self.bounded(op(a, b))
+        if isinstance(n, ast.Compare):
+            a = self.node(n.left, env)
+            for op, right in zip(n.ops, n.comparators):
+                b = self.node(right, env)
+                fn = {ast.Eq: operator.eq, ast.NotEq: operator.ne, ast.Lt: operator.lt,
+                      ast.LtE: operator.le, ast.Gt: operator.gt, ast.GtE: operator.ge,
+                      ast.In: lambda x,y:x in y, ast.NotIn: lambda x,y:x not in y}.get(type(op))
+                if fn is None: raise CalculationError('comparison not allowed')
+                if not fn(a, b): return False
+                a = b
+            return True
+        if isinstance(n, ast.BoolOp):
+            if isinstance(n.op, ast.And): return all(self.node(v, env) for v in n.values)
+            if isinstance(n.op, ast.Or): return any(self.node(v, env) for v in n.values)
+        if isinstance(n, ast.IfExp):
+            return self.node(n.body if self.node(n.test, env) else n.orelse, env)
+        if isinstance(n, ast.Subscript):
+            value = self.node(n.value, env)
+            if not isinstance(value, (list, tuple, str, dict)): raise CalculationError('invalid subscript')
+            if isinstance(n.slice, ast.Slice):
+                parts = [self.node(x, env) if x else None for x in (n.slice.lower, n.slice.upper, n.slice.step)]
+                return self.bounded(value[slice(*parts)])
+            return value[self.node(n.slice, env)]
+        if isinstance(n, (ast.ListComp, ast.GeneratorExp)):
+            if len(n.generators)>2: raise CalculationError('at most two comprehension loops allowed')
+            result=[]
+            def bind(target,value,scope):
+                if isinstance(target,ast.Name): scope[target.id]=value
+                elif isinstance(target,(ast.Tuple,ast.List)) and isinstance(value,(list,tuple)) and len(target.elts)==len(value):
+                    for t,v in zip(target.elts,value):bind(t,v,scope)
+                else:raise CalculationError('invalid comprehension target')
+            def visit(index,scope):
+                if index==len(n.generators):
+                    result.append(self.node(n.elt,scope))
+                    if len(result)>10000:raise CalculationError('result too large')
+                    return
+                g=n.generators[index]
+                if g.is_async:raise CalculationError('async loop not allowed')
+                values=self.node(g.iter,scope)
+                if not isinstance(values,(list,tuple,range,str,dict)) or len(values)>10000:raise CalculationError('invalid sequence')
+                for value in values:
+                    self.steps+=1
+                    if self.steps>50000:raise CalculationError('operation budget exceeded')
+                    child=dict(scope);bind(g.target,value,child)
+                    if all(self.node(test,child) for test in g.ifs):visit(index+1,child)
+            visit(0,env)
+            return self.bounded(result)
+        if isinstance(n,ast.Call) and isinstance(n.func,ast.Attribute) and not n.keywords:
+            value=self.node(n.func.value,env);args=[self.node(a,env) for a in n.args]
+            name=n.func.attr
+            if name in ('index','count') and isinstance(value,(list,tuple,str)):
+                return self.bounded((value.index if name=='index' else value.count)(*args))
+            if name=='get' and isinstance(value,dict):return self.bounded(value.get(*args))
+            if name=='find' and isinstance(value,str):return self.bounded(value.find(*args))
+            if name=='replace' and isinstance(value,str):
+                if len(args) not in (2,3) or not all(isinstance(a,str) for a in args[:2]):raise CalculationError('invalid replace')
+                occurrences=value.count(args[0])
+                if len(args)==3 and args[2]>=0:occurrences=min(occurrences,args[2])
+                if len(value)+occurrences*max(0,len(args[1])-len(args[0]))>10000:raise CalculationError('replace result too large')
+                return self.bounded(value.replace(*args))
+            raise CalculationError('unsupported method: '+name)
+        if isinstance(n, ast.Call) and isinstance(n.func, ast.Name):
+            if any(k.arg is None for k in n.keywords):raise CalculationError('keyword unpacking not allowed')
+            kwargs={}
+            for keyword in n.keywords:
+                value=keyword.value
+                if n.func.id=='sorted' and keyword.arg=='key' and isinstance(value,ast.Lambda):
+                    argspec=value.args
+                    if len(argspec.args)!=1 or argspec.posonlyargs or argspec.kwonlyargs or argspec.defaults or argspec.vararg or argspec.kwarg:
+                        raise CalculationError('sorted key must take one plain argument')
+                    def sort_key(item, body=value.body, arg=argspec.args[0].arg):
+                        return self.node(body,{**env,arg:item})
+                    kwargs['key']=sort_key
+                else:kwargs[keyword.arg]=self.node(value,env)
+            args = [self.node(a, env) for a in n.args]
+            if n.func.id == 'range':
+                r = range(*args,**kwargs)
+                if len(r) > 10000: raise CalculationError('range too large')
+                return r
+            functions = {'abs':abs, 'sum':sum, 'min':min, 'max':max, 'len':len, 'sorted':sorted,
+                         'all':all, 'any':any, 'bin':bin, 'int':int, 'float':float, 'list':list,
+                         'enumerate':lambda x:list(enumerate(x)), 'zip':lambda *x:list(zip(*x)), 'divmod':divmod, 'round':round,
+                         'floor':math.floor, 'ceil':math.ceil, 'sqrt':math.sqrt, 'log2':math.log2,
+                         'partition_hole':partition_hole, 'partition_swap':partition_swap,
+                         'binary_search_trace':binary_search_trace, 'complete_tree_path':complete_tree_path,
+                         'complete_tree_subtree':complete_tree_subtree, 'is_heap':is_heap,
+                         'is_topological_order':is_topological_order, 'linear_probe':linear_probe, 'dijkstra':dijkstra, 'complete_tree_facts':complete_tree_facts}
+            if n.func.id in functions:
+                result = functions[n.func.id](*args,**kwargs)
+                return self.bounded(list(result) if isinstance(result, tuple) else result)
+            raise CalculationError('unsupported function: ' + n.func.id)
+        raise CalculationError('expression node not allowed: ' + type(n).__name__)
+
+
+def check_calculations(items, *, allow_compute_only=False):
+    if not isinstance(items, list) or len(items) > 64:
+        return [], ['calculation_checks_invalid: provide an array of at most 64 checks']
+    evidence, issues, bindings = [], [], {}
+    for item in items:
+        if not isinstance(item, dict) or ('expected' not in item and not allow_compute_only):
+            issues.append('calculation_check_missing_expected');continue
+        expression = item.get('expression')
+        try:
+            actual = Calculator().evaluate(expression, bindings)
+            if isinstance(actual, range): actual = list(actual)
+            name = item.get('name')
+            if name is not None:
+                if not isinstance(name,str) or not name.isidentifier() or name.startswith('_') or name in bindings:
+                    raise CalculationError('invalid or duplicate calculation name')
+                bindings[name] = actual
+            if 'expected' not in item:
+                evidence.append({'expression':expression,'actual':actual,'matches':None,**({'name':name} if name else {})})
+                continue
+            expected = item['expected']
+            equal = math.isclose(actual, expected, rel_tol=1e-9, abs_tol=1e-9) if type(actual) in (int,float) and type(expected) in (int,float) else actual == expected
+            evidence.append({'expression':expression,'actual':actual,'expected':expected,'matches':equal, **({'name':name} if name else {}), **({'question_id':item['question_id']} if item.get('question_id') else {})})
+            if not equal: issues.append('calculation_mismatch: ' + str(expression) + ' = ' + str(actual)[:600] + ', claimed ' + str(expected)[:600])
+        except (CalculationError, ValueError, OverflowError, RecursionError) as exc:
+            issues.append('calculation_unverified: ' + str(expression)[:400] + ': ' + str(exc))
+    return evidence, issues
+
+
+def explanation_arithmetic_issues(payload):
+    """Check explicit numeric equalities, leaving symbolic/approximate claims alone."""
+    import re
+    issues = []
+    for field in ('explanation', 'correct_answer'):
+        source = str(payload.get(field) or '')
+        source = source.replace('$', '').replace('\\times', '*').replace('\\div', '/').replace('×', '*').replace('÷', '/').replace('−', '-')
+        source = source.replace('\\,', '').replace('\\ ', '')
+        source = re.sub(r'\^\{([+\-]?\d+)\}', r'**(\1)', source)
+        source = re.sub(r'\^([+\-]?\d+)', r'**(\1)', source)
+        pattern = r'(?<![\w.^{}\[\])+*/%\-])([+\-]?\d[\d. ()+*/%\-]{0,180})\s*=\s*([+\-]?\d+(?:\.\d+)?)(?![\w.]|\s*[_^/+*\-])'
+        for match in re.finditer(pattern, source):
+            expression, expected = match.groups()
+            if not re.search(r'[+*/%\-]', expression): continue
+            # A pedagogical counterexample may intentionally quote a false equation.
+            prefix = source[max(0,match.start()-28):match.start()]
+            # A numeric-looking suffix of |V|-1 (or x -1) is not a
+            # standalone numeric equality. Whitespace must not hide the
+            # preceding symbolic operand from the regex boundary.
+            if re.match(r'[+\-]', expression.strip()) and re.search(r'[A-Za-z0-9_.)}\]|]$', prefix.rstrip()):
+                continue
+            if re.search(r'错误|错写|误算|并非|不等|incorrect|wrong|not\s*$', prefix, re.I): continue
+            try:
+                actual = Calculator().evaluate(expression.strip())
+                if type(actual) not in (int,float): continue
+                if not math.isclose(actual, float(expected), rel_tol=1e-9, abs_tol=1e-9):
+                    issues.append(f'arithmetic_claim_invalid: {expression.strip()} = {actual}, not {expected}')
+            except (CalculationError, ValueError, OverflowError, RecursionError):
+                continue  # Not an explicit supported numerical claim.
+    for child in payload.get('children') or []:
+        issues.extend(explanation_arithmetic_issues(child))
+    return issues
+
+def check_choice_calculations(solution, question):
+    """For computed single-choice tasks, evaluate every option, not only the winner."""
+    if question.get('question_type') != 'choice' or not solution.get('requires_computation'):
+        return {}, []
+    options = question.get('options') or {}
+    checks = solution.get('option_checks')
+    if not isinstance(options, dict) or not isinstance(checks, dict) or set(checks) != set(options):
+        return {}, ['option_calculations_missing: provide one boolean expression for every exact option key']
+    computed, issues = {}, []
+    bindings = {item['name']: item['actual'] for item in solution.get('computed_checks', []) if item.get('name')}
+    for key, expression in checks.items():
+        try:
+            if not isinstance(expression, str) or isinstance(ast.parse(expression, mode='eval').body, ast.Constant):
+                raise CalculationError('option check must compute from question inputs')
+            value = Calculator().evaluate(expression, bindings)
+            if type(value) is not bool:
+                raise CalculationError('option check must return boolean')
+            computed[key] = {'expression': expression, 'actual': value}
+        except (CalculationError, ValueError, OverflowError, RecursionError, SyntaxError) as exc:
+            issues.append('option_calculation_unverified: ' + str(key) + ': ' + str(exc))
+    winners = [key for key, check in computed.items() if check['actual']]
+    if not issues and len(winners) != 1:
+        issues.append('single_choice_not_unique: computed correct options ' + str(winners))
+    return computed, issues
+
+
+CALCULATOR_GUIDE = """
+complete_tree_subtree(count, root, index_base=0) and complete_tree_path(index, index_base=0) accept base 0 or 1. Pass the indexing base from the candidate explicitly; returned labels use that SAME base. The default remains zero-based.
+Calculations are evaluated in order. Optional name binds the ACTUAL computed result for later expressions,
+e.g. {"name":"nodes","expression":"complete_tree_subtree(12,2)","expected":[2,5,6,11]}.
+In independent solving, expected is optional: OMIT it for helper results you want computed rather than guessed.
+Use the bindings in later calculations and option_checks; never assign expected values as intermediate facts.
+Supported: arithmetic, comparisons, indexing, slices, dict literals, conditional expressions, up to two
+bounded comprehension loops including tuple unpacking, range, enumerate, zip, list, int, float.
+Also abs,sum,min,max,len,sorted,all,any,bin,divmod,round,floor,ceil,sqrt,log2.
+Only readonly container methods index/count, dict.get, and string find/replace are allowed. sorted accepts a one-argument key=lambda x: expression evaluated by this same restricted calculator. No other lambdas, attributes, imports or arbitrary code. Limits: 10000 items, 50000 steps.
+""" + ALGORITHM_GUIDE
+
+
+def tree_answer_claims(evidence, question):
+    """Require a checked comparison for every answer slot, derived from computed tree facts."""
+    slots=[];answers={}
+    def visit(node):
+        if node.get('children'):
+            for child in node['children']:visit(child)
+        else:
+            qid=node.get('question_id') or 'root';slots.append(qid);answers[qid]=node.get('correct_answer','')
+    visit(question)
+    derived=set();claims_checked=[]
+    for item in evidence:
+        expr=ast.parse(item['expression'],mode='eval').body
+        rooted=any(isinstance(n,ast.Call) and isinstance(n.func,ast.Name) and n.func.id in ('complete_tree_facts','complete_tree_subtree','complete_tree_path') for n in ast.walk(expr))
+        rooted=rooted or any(isinstance(n,ast.Name) and n.id in derived for n in ast.walk(expr))
+        if rooted and item.get('name'):derived.add(item['name'])
+        if rooted and item.get('question_id') in slots and type(item.get('actual')) is bool and item.get('expected') is True and isinstance(expr,(ast.Compare,ast.BoolOp)):
+            # An approving reviewer must not substitute its corrected number
+            # for the number actually written in the candidate's answer.
+            import re
+            answer=str(answers[item['question_id']]).replace('$','')
+            first_clause=re.split(r'[。;；\n]',answer)[0]
+            numbers=set(re.findall(r'(?<![A-Za-z_\d])\d+(?:\.\d+)?(?![\d.])',first_clause))
+            claims=[]
+            for comp in (x for x in ast.walk(expr) if isinstance(x,ast.Compare)):
+                for operand in [comp.left,*comp.comparators]:
+                    if any((isinstance(n,ast.Call) and isinstance(n.func,ast.Name) and n.func.id in ('complete_tree_facts','complete_tree_subtree','complete_tree_path')) or (isinstance(n,ast.Name) and n.id in derived) for n in ast.walk(operand)):
+                        continue  # This side is computed evidence, not the candidate's literal claim.
+                    try:value=Calculator().evaluate(ast.unparse(operand))
+                    except (CalculationError,ValueError,OverflowError,RecursionError):continue
+                    if type(value) in (int,float):claims.append(str(value))
+                    if isinstance(value,list):claims.extend(str(v) for v in value if type(v) in (int,float))
+            if numbers and (not claims or any(value not in numbers for value in claims)):continue
+            claims_checked.append((item['question_id'],item['actual']))
+    return slots,claims_checked
+
+
+def check_tree_answer_assertions(evidence, question):
+    slots,claims=tree_answer_claims(evidence,question)
+    covered={qid for qid,actual in claims if actual}
+    return ['tree_answer_unverified: '+qid for qid in slots if qid not in covered]
