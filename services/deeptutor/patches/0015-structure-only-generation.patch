+def extract_questions_with_llm(markdown_content, content_list, images_dir, api_key, base_url,
+                               model, api_version=None, binding=None):
+    """Read every line. Overlapping windows reconcile source spans, never ordinal guesses.
+
+    An unresolved boundary question causes an explicit extraction failure. It cannot
+    silently produce a shorter paper. Source line anchors also distinguish repeated
+    numbering in different sections from overlap duplicates.
+    """
+    lines = markdown_content.splitlines(keepends=True)
+    if not lines:
+        raise ValueError("Empty exam source")
+    windows = []
+    start = 0
+    while start < len(lines):
+        end, size = start, 0
+        while end < len(lines) and (size < 6000 or end == start):
+            size += len(lines[end])
+            end += 1
+        windows.append((start, end))
+        if end == len(lines):
+            break
+        # Enough overlap for ordinary cross-page stems; larger ones get a targeted pass.
+        overlap, chars = end, 0
+        while overlap > start + 1 and chars < 1000:
+            overlap -= 1
+            chars += len(lines[overlap])
+        start = overlap
+    found, pending, conflicts = {}, set(), {}
+    ignored = set()
+    def same_number(one, two):
+        return str(one.get("question_number") or "").strip(" .、．()") == str(two.get("question_number") or "").strip(" .、．()") != ""
+
+    def extract(start, end, *, reconcile=False):
+        window = "".join(f"[L{i+1}] {lines[i]}" + ("" if lines[i].endswith("\n") else "\n") for i in range(start, end))
+        if end == len(lines):
+            window += "\n[END OF DOCUMENT]"
+        try:
+            data = _extract_question_window(window, content_list, images_dir, api_key, base_url, model, api_version, binding)
+        except ValueError as exc:
+            if "EXAM_EXTRACTION_INVALID_JSON" not in str(exc):
+                raise
+            # One bounded format retry; never accept a repaired partial paper.
+            correction = "\n[FORMAT CORRECTION: Return ONE complete JSON object with questions and incomplete_questions arrays, including the closing brace. Do not return a bare array or truncate any question.]"
+            data = _extract_question_window(window + correction, content_list, images_dir, api_key, base_url, model, api_version, binding)
+        def invalid_spans(value):
+            return not isinstance(value.get("questions"), list) or any(
+                not isinstance(item, dict) or type(item.get("source_start_line")) is not int or
+                type(item.get("source_end_line")) is not int or
+                not start < item["source_start_line"] <= item["source_end_line"] <= end
+                for item in value["questions"])
+        def invalid_partials(value):
+            incomplete = value.get("incomplete_questions", [])
+            return (not isinstance(incomplete, list) or any(
+                type(n) is not int or not start < n <= end for n in incomplete))
+        def invalid_shapes(value):
+            errors = []
+            def check(item, label):
+                children = item.get("children") or []
+                kind = item.get("question_type")
+                if (not isinstance(children, list) or any(not isinstance(c, dict) for c in children)
+                        or (kind == "compound" and not children)
+                        or (kind != "compound" and children)):
+                    errors.append(f"{label}: compound must have nonempty ordered children; other types must have no children")
+                    return
+                for index, child in enumerate(children, 1):
+                    check(child, f"{label}.{index}")
+            nested = {}
+            headings = [(i + 1, match.group(1)) for i in range(start, end)
+                        if (match := re.match(r"^\s*#{1,6}\s+(?:Question\s+)?(\d+)(?:[.)、．]|\s)", lines[i], re.I))]
+            for item in value.get("questions", []):
+                if isinstance(item, dict):
+                    check(item, str(item.get("question_number", "?")))
+                    number = re.fullmatch(r"(\d+)\s*[.(（]?([a-z])\s*[)）.]?", str(item.get("question_number", "")).strip(), re.I)
+                    first = item.get("source_start_line")
+                    if number and type(first) is int:
+                        preceding = [(line, n) for line, n in headings if line < first]
+                        if preceding and preceding[-1][1] == number.group(1):
+                            nested.setdefault(preceding[-1], set()).add(number.group(2).lower())
+            for (line, number), parts in nested.items():
+                if len(parts) >= 2:
+                    errors.append(f"L{line}: numbered parent {number} was flattened; keep its lettered subquestions inside ONE compound parent with ordered children")
+            return errors
+        shape_errors = invalid_shapes(data)
+        if invalid_spans(data) or invalid_partials(data) or shape_errors:
+            correction = ("\n[EXTRACTION CORRECTION: Your previous extraction has missing or out-of-window source spans or partial-question anchors. "
+                          "Re-extract ALL questions. For EACH top-level question supply integer source_start_line and "
+                          "source_end_line from the actual L markers above. incomplete_questions must be an array of "
+                          "integer L-marker start lines inside this window, not objects, strings, or question numbers. "
+                          "Use [] when there are no incomplete questions. Do not use question numbers as line numbers. "
+                          f"Valid line numbers in THIS window are {start + 1} through {end}, inclusive. "
+                          "A partial question contributes ONLY its START line, not a range of later/missing lines. "
+                          f"Never invent future line numbers greater than {end}, even if a page image shows more text. "
+                          "Re-extract from the original window; do not copy the invalid anchors. "
+                          "Every compound MUST contain all ordered children; never return an empty children array. "
+                          f"Structural errors to fix: {json.dumps(shape_errors, ensure_ascii=False)}. "
+                          "Preserve the complete questions, options and children.]\n")
+            data = _extract_question_window(window + correction, content_list, images_dir, api_key, base_url, model, api_version, binding)
+        shape_errors = invalid_shapes(data)
+        if shape_errors:
+            raise ValueError("Invalid extracted question structure: " + "; ".join(shape_errors))
+        incomplete = data.get("incomplete_questions", [])
+        if not isinstance(incomplete, list) or any(type(n) is not int or not start < n <= end for n in incomplete):
+            raise ValueError("Invalid partial-question anchors")
+        pending.update(incomplete)
+        for item in data["questions"]:
+            first, last = item.get("source_start_line"), item.get("source_end_line")
+            if type(first) is not int or type(last) is not int or not start < first <= last <= end:
+                raise ValueError("Question lacks a valid complete source span")
+            source = "".join(lines[first - 1:last])
+            if _administrative_form(source):
+                ignored.update(range(first, last + 1))
+                continue
+            # Overlap responses may anchor the same numbered question at its
+            # heading or at the stem two lines later. A nested fragment is not
+            # an additional top-level question. Disjoint repeated numbers stay.
+            containers = [n for n, previous in found.items() if n < first
+                          and last <= previous["source_end_line"] and same_number(previous, item)]
+            if containers:
+                continue
+            for n in list(found):
+                if first < n and found[n]["source_end_line"] <= last and same_number(found[n], item):
+                    found.pop(n)
+                    conflicts.pop(n, None)
+            # Prefer the widest complete span when both overlap windows saw the question.
+            old = found.get(first)
+            if old and old.get("question_type") != item.get("question_type") and not reconcile:
+                conflicts[first] = max(last, old["source_end_line"])
+            if reconcile or not old or last > old["source_end_line"]:
+                found[first] = item
+    for start, end in windows:
+        extract(start, end)
+    # A boundary window can lack the section heading or later children. Resolve
+    # disagreements against the complete source span instead of guessing a type.
+    for first, last in sorted(conflicts.items()):
+        extract(first - 1, last, reconcile=True)
+    # A long question may exceed an ordinary window. Read from its known start
+    # through the next complete question (or document end), without clipping.
+    def covered(line):
+        return any(item["source_start_line"] <= line <= item["source_end_line"] for item in found.values())
+    for first in sorted(pending - found.keys()):
+        if covered(first):
+            continue
+        following = [n for n in found if n > first]
+        end = min(following) - 1 if following else len(lines)
+        if _administrative_form("".join(lines[first - 1:end])):
+            ignored.add(first)
+            continue
+        # A partial anchor can point at a continuation (e.g. an answer-box
+        # image), not its parent heading. Re-reading only that tail cannot
+        # recover the stem. Include the closest preceding complete question
+        # so the extractor can extend it or identify a separate missing item.
+        preceding = [n for n in found if n < first]
+        begin = max(preceding) if preceding else first
+        extract(begin - 1, end, reconcile=True)
+    unresolved = {line for line in pending if line not in ignored and not covered(line)}
+    if unresolved or not found:
+        raise ValueError(f"Exam extraction has unresolved partial or missing questions: lines {sorted(unresolved)}")
+    questions = [found[n] for n in sorted(found)]
+    # Preserve source evidence in addition to the LLM's transcription.
+    for item in questions:
+        item["source_text"] = "".join(lines[item["source_start_line"]-1:item["source_end_line"]])
+        pages = set()
+        for block in content_list or []:
+            if not isinstance(block, dict) or type(block.get("page_idx")) is not int:
+                continue
+            text = str(block.get("text") or "").strip()
+            if text and (text in item["source_text"] or item["source_text"].strip() in text):
+                pages.add(block["page_idx"])
+        if pages:
+            item["page_indices"] = sorted(pages)
     return questions
 
 
