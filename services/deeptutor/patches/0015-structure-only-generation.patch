new file mode 100644
index 0000000..56141e9
--- /dev/null
+++ b/deeptutor/agents/question/tree_explanation.py
@@ -0,0 +1,60 @@
+"""Render complete-tree derivations from computed structure, not guessed index intervals."""
+import ast
+import re
+from .calculation_check import Calculator,CalculationError,complete_tree_subtree
+
+
+def _ranges(values):
+    values=sorted(values);parts=[]
+    for value in values:
+        if parts and value==parts[-1][1]+1:parts[-1][1]=value
+        else:parts.append([value,value])
+    return '、'.join(str(a) if a==b else f'{a}～{b}' for a,b in parts) or '无'
+
+
+def render_tree_explanation(question, evidence):
+    facts=next((x['actual'] for x in evidence if isinstance(x.get('actual'),dict)
+                and {'node_count','index_base','target','path','leaves_to_left'}<=x['actual'].keys()),None)
+    if not facts:return False
+    n,base=facts['node_count'],facts['index_base'];root=facts['top_subtree_root']-base
+    # Never inject facts extracted from an absent input into the displayed answer.
+    inputs={int(x) for x in re.findall(r'\d+',str(question.get('question','')))}
+    if n not in inputs or facts['target'] not in inputs:return False
+    nodes=complete_tree_subtree(n,root);leaves=[i+base for i in nodes if 2*i+1>=n]
+    parent='⌊(i−1)/2⌋' if base==0 else '⌊i/2⌋'
+    left='2i+1' if base==0 else '2i';right='2i+2' if base==0 else '2i+1'
+    side={'left':'左子树','right':'右子树','root':'整棵树'}[facts['top_subtree_side']]
+    path=' → '.join(map(str,facts['path']))
+    intro=f'本题按层序从 {base} 编号，共 {n} 个结点，有效编号为 {base}～{n-1+base}。结点 i 的左、右孩子编号分别为 {left}、{right}，超过有效编号范围的孩子不存在；非根结点的父编号为 {parent}。'
+    location=f'目标结点 {facts["target"]} 的根到结点路径是 {path}，因此它位于{side}（子树根编号 {root+base}）。判断归属必须沿父子路径，不能将子树视为全局层序编号中的一个连续区间。'
+    leaf=f'该子树的叶子编号为 {_ranges(leaves)}，共 {len(leaves)} 个。其中编号小于 {facts["target"]} 的叶子有 {facts["leaves_before_by_label"]} 个；按从左到右的空间顺序位于目标左侧的叶子有 {facts["leaves_to_left"]} 个。这两种顺序不能混用，应按题目指定的顺序取值。'
+    structure=[f'以 {root+base} 为根的子树共有 {facts["top_subtree_count"]} 个结点、{facts["top_subtree_height"]} 层，最大编号为 {facts["top_subtree_max_label"]}。']
+    roots={root};bindings={}
+    for item in evidence:
+        for call in ast.walk(ast.parse(item['expression'],mode='eval')):
+            if isinstance(call,ast.Call) and isinstance(call.func,ast.Name) and call.func.id=='complete_tree_subtree' and len(call.args)==2:
+                try:
+                    count=Calculator().evaluate(ast.unparse(call.args[0]),bindings)
+                    candidate=Calculator().evaluate(ast.unparse(call.args[1]),bindings)
+                    if count==n and type(candidate) is int and 0<=candidate<n:roots.add(candidate)
+                except (CalculationError,ValueError,OverflowError,RecursionError):pass
+        if item.get('name'):bindings[item['name']]=item['actual']
+    for subroot in sorted(roots):
+        sub=complete_tree_subtree(n,subroot)
+        if len(sub)>63:continue
+        level=[subroot];levels=[]
+        while level:
+            levels.append([i+base for i in level]);level=[child for i in level for child in (2*i+1,2*i+2) if child<n]
+        detail='；'.join(f'第 {i+1} 层：'+ '、'.join(map(str,v)) for i,v in enumerate(levels))
+        structure.append(f'以 {subroot+base} 为根的子树按层展开：{detail}。共 {len(sub)} 个结点、{len(levels)} 层。所有孩子关系均使用上述编号公式。')
+    common='\n\n'.join([intro,location,leaf,*structure])
+    question['explanation']=common
+    for child in question.get('children') or []:
+        # Separate a concise answer from an authored "because" clause; the
+        # reason is now replaced with the verified derivation, not discarded.
+        answer=str(child.get('correct_answer',''))
+        child['correct_answer']=re.split(r'因为|理由是|\bbecause\b',answer,maxsplit=1,flags=re.I)[0].rstrip('，, ;；')
+        child['explanation']=common
+    if question.get('children'):
+        question['correct_answer']='；'.join(f'（{i+1}）'+str(c.get('correct_answer','')) for i,c in enumerate(question['children']))
+    return True
