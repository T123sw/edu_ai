+def _administrative_form(text):
+    """Recognize form-filling instructions, never a question by its ordinal."""
+    value = re.sub(r"\s+", " ", text).lower()
+    identity = re.search(r"write (?:your|the) name|fill (?:in|out).*name|填写.*(?:姓名|学号)", value)
+    form = re.search(r"honor code pledge|sign.*pledge|exam room.*precept|签(?:名|署).*承诺", value)
+    return bool(identity and form)
+
