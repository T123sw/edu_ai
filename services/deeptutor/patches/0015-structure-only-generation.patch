+"""Bounded recovery for transient model transport errors; cancellation always propagates."""
+import asyncio
+import httpx
+from openai import APIConnectionError, APIStatusError
+
+
+def transient_model_error(exc):
+    return isinstance(exc, (httpx.TimeoutException, httpx.TransportError, APIConnectionError)) or (
+        isinstance(exc, APIStatusError) and exc.status_code in (408,429,500,502,503,504))
+
+
+async def model_call_with_retry(call, *, notify=None):
+    for attempt in range(3):
+        try:
+            return await call()
+        except Exception as exc:
+            if not transient_model_error(exc) or attempt==2:raise
+            if notify is not None:await notify(attempt+1)
+            await asyncio.sleep(2**attempt)
