    "id": "os-brief-root",
    "data": {
      "type": "course",
      "summary": "8 课时入门课程，覆盖进程与线程、CPU 调度、进程同步、死锁与虚拟内存的核心概念与基本算法。"
    },
    "label": "操作系统（简明版）",
    "children": [
      {
        "id": "os-brief-m2",
        "data": {
          "type": "knowledge_module",
          "summary": "理解进程与线程的概念、状态与基本操作。"
        },
        "label": "进程与线程",
        "children": [
          {
            "id": "os-brief-m2-u1",
            "data": {
              "type": "knowledge_unit",
              "summary": "进程的定义、状态与进程控制块。"
            },
            "label": "进程基础",
            "children": [
              {
                "id": "os-brief-m2-u1-p1",
                "data": {
                  "type": "knowledge_point",
                  "summary": "能描述进程的就绪、运行、阻塞三种基本状态及其转换条件。"
                },
                "label": "进程的概念与状态转换",
                "children": []
              },
              {
                "id": "os-brief-m2-u1-p2",
                "data": {
                  "type": "knowledge_point",
                  "summary": "能说明 PCB 保存的信息，并用 fork 说明进程创建过程。"
                },
                "label": "进程控制块与进程创建",
                "children": []
              }
            ]
          },
          {
            "id": "os-brief-m2-u2",
            "data": {
              "type": "knowledge_unit",
              "summary": "线程的概念及与进程的区别。"
            },
            "label": "线程",
            "children": [
              {
                "id": "os-brief-m2-u2-p1",
                "data": {
                  "type": "knowledge_point",
                  "summary": "能解释线程共享进程资源、独立调度的特点，并比较进程与线程的开销。"
                },
                "label": "线程的概念与进程/线程对比",
                "children": []
              }
            ]
          }
        ]
      },
      {
        "id": "os-brief-m3",
        "data": {
          "type": "knowledge_module",
          "summary": "理解调度目标与常见调度算法的基本行为。"
        },
        "label": "CPU 调度",
        "children": [
          {
            "id": "os-brief-m3-u1",
            "data": {
              "type": "knowledge_unit",
              "summary": "调度时机与典型调度算法。"
            },
            "label": "调度基础与算法",
            "children": [
              {
                "id": "os-brief-m3-u1-p1",
                "data": {
                  "type": "knowledge_point",
                  "summary": "能说明吞吐量、周转时间、响应时间等调度目标及常见调度时机。"
                },
                "label": "调度目标与调度时机",
                "children": []
              },
              {
                "id": "os-brief-m3-u1-p2",
                "data": {
                  "type": "knowledge_point",
                  "summary": "能按 FCFS 与 SJF 计算一组进程的等待时间并比较结果。"
                },
                "label": "先来先服务与短作业优先",
                "children": []
              },
              {
                "id": "os-brief-m3-u1-p3",
                "data": {
                  "type": "knowledge_point",
                  "summary": "能说明 RR 与优先级调度的基本规则，并计算简单例子的等待时间。"
                },
                "label": "时间片轮转与优先级调度",
                "children": []
              }
            ]
          }
        ]
      },
      {
        "id": "os-brief-m4",
        "data": {
          "type": "knowledge_module",
          "summary": "理解并发问题与信号量基本用法。"
        },
        "label": "进程同步",
        "children": [
          {
            "id": "os-brief-m4-u1",
            "data": {
              "type": "knowledge_unit",
              "summary": "临界区问题与信号量机制。"
            },
            "label": "同步基础与信号量",
            "children": [
              {
                "id": "os-brief-m4-u1-p1",
                "data": {
                  "type": "knowledge_point",
                  "summary": "能解释竞态条件的产生原因及临界区互斥的基本要求。"
                },
                "label": "临界区与竞态条件",
                "children": []
              },
              {
                "id": "os-brief-m4-u1-p2",
                "data": {
                  "type": "knowledge_point",
                  "summary": "能说明信号量的含义及 P、V 操作对信号量值的改变。"
                },
                "label": "信号量的 P/V 操作",
                "children": []
              },
              {
                "id": "os-brief-m4-u1-p3",
                "data": {
                  "type": "knowledge_point",
                  "summary": "能用信号量写出生产者-消费者问题的基本同步框架。"
                },
                "label": "用信号量解决互斥与同步",
                "children": []
              }
            ]
          }
        ]
      },
      {
        "id": "os-brief-m5",
        "data": {
          "type": "knowledge_module",
          "summary": "理解死锁条件与基本处理策略。"
        },
        "label": "死锁",
        "children": [
          {
            "id": "os-brief-m5-u1",
            "data": {
              "type": "knowledge_unit",
              "summary": "死锁的成因与处理思路。"
            },
            "label": "死锁基础",
            "children": [
              {
                "id": "os-brief-m5-u1-p1",
                "data": {
                  "type": "knowledge_point",
                  "summary": "能说明互斥、占有并等待、非抢占、循环等待四个条件。"
                },
                "label": "死锁的四个必要条件",
                "children": []
              },
              {
                "id": "os-brief-m5-u1-p2",
                "data": {
                  "type": "knowledge_point",
                  "summary": "能说明破坏必要条件进行预防，以及银行家算法的基本思想。"
                },
                "label": "死锁的预防与避免",
                "children": []
              }
            ]
          }
        ]
      },
      {
        "id": "os-brief-m6",
        "data": {
          "type": "knowledge_module",
          "summary": "理解分页、缺页与页面置换的基本机制。"
        },
        "label": "虚拟内存",
        "children": [
          {
            "id": "os-brief-m6-u1",
            "data": {
              "type": "knowledge_unit",
              "summary": "分页机制与虚拟地址到物理地址的转换。"
            },
            "label": "分页与地址转换",
            "children": [
              {
                "id": "os-brief-m6-u1-p1",
                "data": {
                  "type": "knowledge_point",
                  "summary": "能说明页、页框、页表的作用，并完成简单的地址转换。"
                },
                "label": "分页与页表",
                "children": []
              },
              {
                "id": "os-brief-m6-u1-p2",
                "data": {
                  "type": "knowledge_point",
                  "summary": "能解释缺页中断的处理流程，并用 FIFO、LRU 计算简单置换过程。"
                },
                "label": "缺页与页面置换",
                "children": []
              }
            ]
          }
        ]
      }
    ]
  },
