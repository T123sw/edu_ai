  "graph_draft": {
    "id": "course-7f46fe9e9ad0468abb03b62588e3b01f",
    "data": {
      "type": "course",
      "summary": "面向计算机专业大二学生的操作系统入门课程，8 课时必修，覆盖进程与线程、CPU 调度、进程同步、死锁和虚拟内存五大主题，强调机制理解与可验证的例子练习。"
    },
    "label": "操作系统",
    "children": [
      {
        "id": "mod-process-thread",
        "data": {
          "type": "knowledge_module",
          "summary": "理解进程与线程的基本概念、状态变化和系统调用机制，是后续调度与同步的基础。"
        },
        "label": "进程与线程",
        "children": [
          {
            "id": "kp-process-concept",
            "data": {
              "type": "knowledge_point",
              "summary": "进程的定义、程序与进程的区别、进程控制块 PCB 的作用；配合一个 C 程序运行时的进程映像示例。"
            },
            "label": "进程的概念与组成",
            "children": []
          },
          {
            "id": "kp-process-state",
            "data": {
              "type": "knowledge_point",
              "summary": "就绪、运行、阻塞三种基本状态及其转换条件；用状态转换图配合一个进程生命周期例子讲解。"
            },
            "label": "进程状态与转换",
            "children": []
          },
          {
            "id": "kp-system-call",
            "data": {
              "type": "knowledge_point",
              "summary": "系统调用的作用、用户态与内核态切换；以 fork、exec、wait 为例说明进程相关系统调用的使用与验证。"
            },
            "label": "系统调用",
            "children": []
          },
          {
            "id": "kp-thread-concept",
            "data": {
              "type": "knowledge_point",
              "summary": "线程与进程的区别、用户级线程与内核级线程的基本概念；配合一个多线程 C 程序示例。"
            },
            "label": "线程的概念与实现",
            "children": []
          }
        ]
      },
      {
        "id": "mod-cpu-scheduling",
        "data": {
          "type": "knowledge_module",
          "summary": "掌握常见 CPU 调度算法的规则与等待时间计算，能比较不同算法的特点。"
        },
        "label": "CPU 调度",
        "children": [
          {
            "id": "kp-scheduling-basic",
            "data": {
              "type": "knowledge_point",
              "summary": "调度层次、调度时机、周转时间与等待时间的定义；用一个进程序列示例计算指标。"
            },
            "label": "调度基本概念与评价指标",
            "children": []
          },
          {
            "id": "kp-fcfs-sjf",
            "data": {
              "type": "knowledge_point",
              "summary": "FCFS 与 SJF 的调度规则、优缺点；用同一组进程数据对比计算等待时间。"
            },
            "label": "先来先服务与短作业优先",
            "children": []
          },
          {
            "id": "kp-rr-priority",
            "data": {
              "type": "knowledge_point",
              "summary": "RR 的时间片设置与优先级调度的基本规则；用可验证的进程序列练习计算等待时间。"
            },
            "label": "时间片轮转与优先级调度",
            "children": []
          }
        ]
      },
      {
        "id": "mod-synchronization",
        "data": {
          "type": "knowledge_module",
          "summary": "理解并发带来的竞争问题，掌握信号量机制并能分析典型同步问题。"
        },
        "label": "进程同步",
        "children": [
          {
            "id": "kp-critical-section",
            "data": {
              "type": "knowledge_point",
              "summary": "临界区问题的描述与三个基本要求；用一个共享计数器并发错误示例说明竞争条件。"
            },
            "label": "临界区与竞争条件",
            "children": []
          },
          {
            "id": "kp-semaphore",
            "data": {
              "type": "knowledge_point",
              "summary": "信号量的定义、P/V 操作及其语义；用伪代码演示互斥与同步的基本用法。"
            },
            "label": "信号量机制",
            "children": []
          },
          {
            "id": "kp-classic-sync",
            "data": {
              "type": "knowledge_point",
              "summary": "生产者-消费者问题的信号量解法；给出可执行或可逐步验证的伪代码分析。"
            },
            "label": "典型同步问题",
            "children": []
          }
        ]
      },
      {
        "id": "mod-deadlock",
        "data": {
          "type": "knowledge_module",
          "summary": "理解死锁的成因与必要条件，掌握基本的预防、避免与检测思路。"
        },
        "label": "死锁",
        "children": [
          {
            "id": "kp-deadlock-concept",
            "data": {
              "type": "knowledge_point",
              "summary": "死锁的定义、四个必要条件；用两个进程互相等待资源的例子说明。"
            },
            "label": "死锁的概念与必要条件",
            "children": []
          },
          {
            "id": "kp-deadlock-handling",
            "data": {
              "type": "knowledge_point",
              "summary": "预防、避免、检测与恢复的基本思路；用资源分配图示例判断是否可能死锁。"
            },
            "label": "死锁的处理策略",
            "children": []
          }
        ]
      },
      {
        "id": "mod-virtual-memory",
        "data": {
          "type": "knowledge_module",
          "summary": "理解分页、缺页与页面置换的基本机制，能解释常见置换算法的行为。"
        },
        "label": "虚拟内存",
        "children": [
          {
            "id": "kp-paging",
            "data": {
              "type": "knowledge_point",
              "summary": "页表、逻辑地址到物理地址的转换过程；用一个地址转换示例逐步计算。"
            },
            "label": "分页与地址转换",
            "children": []
          },
          {
            "id": "kp-page-fault",
            "data": {
              "type": "knowledge_point",
              "summary": "缺页中断的处理流程；用页面访问序列演示 FIFO 与 LRU 的置换过程。"
            },
            "label": "缺页与页面置换",
            "children": []
          }
        ]
      }
    ]
  },
