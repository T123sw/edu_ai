  "graph_draft": {
    "id": "course-90dd97100b664a21bcacf05c335d2979-brief",
    "data": {
      "type": "course",
      "summary": "8 课时入门课程，覆盖进程与线程、CPU 调度、进程同步、死锁与虚拟内存的核心概念与基本方法。"
    },
    "label": "操作系统（简明版）",
    "children": [
      {
        "id": "m-process-thread-brief",
        "data": {
          "type": "knowledge_module",
          "summary": "理解进程与线程的概念、状态变化及二者区别。"
        },
        "label": "进程与线程",
        "children": [
          {
            "id": "kp-process-concept-brief",
            "data": {
              "type": "knowledge_point",
              "summary": "进程定义、PCB 与程序、进程的区别。"
            },
            "label": "进程的概念与组成",
            "children": []
          },
          {
            "id": "kp-process-state-brief",
            "data": {
              "type": "knowledge_point",
              "summary": "就绪、运行、阻塞等基本状态及其转换条件。"
            },
            "label": "进程状态与转换",
            "children": []
          },
          {
            "id": "kp-thread-brief",
            "data": {
              "type": "knowledge_point",
              "summary": "线程作为调度单位、进程作为资源单位的基本区别与共享内容。"
            },
            "label": "线程的概念与进程/线程区别",
            "children": []
          }
        ]
      },
      {
        "id": "m-cpu-sched-brief",
        "data": {
          "type": "knowledge_module",
          "summary": "理解调度目标与常见调度算法的基本思想，能计算简单等待时间。"
        },
        "label": "CPU 调度",
        "children": [
          {
            "id": "kp-sched-basic-brief",
            "data": {
              "type": "knowledge_point",
              "summary": "调度时机、周转时间与等待时间的基本含义。"
            },
            "label": "调度基本概念与评价指标",
            "children": []
          },
          {
            "id": "kp-sched-algo-brief",
            "data": {
              "type": "knowledge_point",
              "summary": "三种基本调度算法的规则与简单等待时间计算。"
            },
            "label": "常见调度算法（FCFS、SJF、RR）",
            "children": []
          }
        ]
      },
      {
        "id": "m-sync-brief",
        "data": {
          "type": "knowledge_module",
          "summary": "理解临界区问题与信号量基本用法，能解决简单同步问题。"
        },
        "label": "进程同步",
        "children": [
          {
            "id": "kp-critical-brief",
            "data": {
              "type": "knowledge_point",
              "summary": "临界区问题、互斥要求与忙等待的基本概念。"
            },
            "label": "临界区与互斥",
            "children": []
          },
          {
            "id": "kp-semaphore-brief",
            "data": {
              "type": "knowledge_point",
              "summary": "P/V 操作语义及用信号量实现互斥的基本方法。"
            },
            "label": "信号量机制",
            "children": []
          },
          {
            "id": "kp-classic-sync-brief",
            "data": {
              "type": "knowledge_point",
              "summary": "用信号量分析并解决生产者-消费者问题的基本思路。"
            },
            "label": "典型同步问题（生产者-消费者）",
            "children": []
          }
        ]
      },
      {
        "id": "m-deadlock-brief",
        "data": {
          "type": "knowledge_module",
          "summary": "理解死锁产生条件与基本处理策略。"
        },
        "label": "死锁",
        "children": [
          {
            "id": "kp-deadlock-cond-brief",
            "data": {
              "type": "knowledge_point",
              "summary": "互斥、占有并等待、非抢占、循环等待四个必要条件。"
            },
            "label": "死锁产生条件",
            "children": []
          },
          {
            "id": "kp-deadlock-handle-brief",
            "data": {
              "type": "knowledge_point",
              "summary": "预防、避免、检测与解除的基本思想。"
            },
            "label": "死锁处理策略",
            "children": []
          }
        ]
      },
      {
        "id": "m-vm-brief",
        "data": {
          "type": "knowledge_module",
          "summary": "理解分页、缺页与页面置换的基本机制。"
        },
        "label": "虚拟内存",
        "children": [
          {
            "id": "kp-paging-brief",
            "data": {
              "type": "knowledge_point",
              "summary": "页、页框、页表与逻辑地址到物理地址的基本转换。"
            },
            "label": "分页与地址转换",
            "children": []
          },
          {
            "id": "kp-pagefault-brief",
            "data": {
              "type": "knowledge_point",
              "summary": "缺页中断处理流程与 FIFO、LRU 置换算法的基本思想。"
            },
            "label": "缺页与页面置换",
            "children": []
          }
        ]
      }
    ]
  },
