    "id": "course-e1b066fd19c747188a1da27135b74992-brief",
    "data": {
      "type": "course",
      "summary": "8 课时入门课程，覆盖进程与线程、CPU 调度、进程同步、死锁、虚拟内存的核心机制与典型算法。"
    },
    "label": "操作系统（简明版）",
    "children": [
      {
        "id": "mod-process-thread-brief",
        "data": {
          "type": "knowledge_module",
          "summary": "理解进程与线程的概念、状态与基本操作。"
        },
        "label": "进程与线程",
        "children": [
          {
            "id": "kp-process-concept-brief",
            "data": {
              "type": "knowledge_point",
              "summary": "解释进程定义、PCB 与就绪/运行/阻塞三态转换。"
            },
            "label": "进程的概念与状态",
            "children": []
          },
          {
            "id": "kp-thread-concept-brief",
            "data": {
              "type": "knowledge_point",
              "summary": "说明线程的引入动机、共享资源与独立栈/寄存器上下文。"
            },
            "label": "线程的概念与进程/线程区别",
            "children": []
          },
          {
            "id": "kp-process-ops-brief",
            "data": {
              "type": "knowledge_point",
              "summary": "描述 fork/exec/wait 的基本语义与上下文切换开销。"
            },
            "label": "进程创建、终止与上下文切换",
            "children": []
          }
        ]
      },
      {
        "id": "mod-cpu-sched-brief",
        "data": {
          "type": "knowledge_module",
          "summary": "掌握基本调度算法并能计算等待时间。"
        },
        "label": "CPU 调度",
        "children": [
          {
            "id": "kp-sched-basic-brief",
            "data": {
              "type": "knowledge_point",
              "summary": "理解调度时机、抢占与非抢占、周转时间与等待时间。"
            },
            "label": "调度基本概念与评价指标",
            "children": []
          },
          {
            "id": "kp-sched-fcfs-sjf-brief",
            "data": {
              "type": "knowledge_point",
              "summary": "比较先来先服务与短作业优先，计算等待时间。"
            },
            "label": "FCFS 与 SJF 调度",
            "children": []
          },
          {
            "id": "kp-sched-rr-brief",
            "data": {
              "type": "knowledge_point",
              "summary": "理解时间片轮转机制及其对响应时间的影响。"
            },
            "label": "时间片轮转调度",
            "children": []
          }
        ]
      },
      {
        "id": "mod-sync-brief",
        "data": {
          "type": "knowledge_module",
          "summary": "理解临界区问题并用信号量解决典型同步问题。"
        },
        "label": "进程同步",
        "children": [
          {
            "id": "kp-critical-section-brief",
            "data": {
              "type": "knowledge_point",
              "summary": "解释临界区问题与互斥、进展、有限等待三条要求。"
            },
            "label": "临界区与互斥",
            "children": []
          },
          {
            "id": "kp-semaphore-brief",
            "data": {
              "type": "knowledge_point",
              "summary": "理解信号量定义与 P/V 原语语义。"
            },
            "label": "信号量与 P/V 操作",
            "children": []
          },
          {
            "id": "kp-producer-consumer-brief",
            "data": {
              "type": "knowledge_point",
              "summary": "用信号量分析并解决生产者-消费者同步问题。"
            },
            "label": "生产者-消费者问题",
            "children": []
          }
        ]
      },
      {
        "id": "mod-deadlock-brief",
        "data": {
          "type": "knowledge_module",
          "summary": "理解死锁条件与基本处理策略。"
        },
        "label": "死锁",
        "children": [
          {
            "id": "kp-deadlock-conditions-brief",
            "data": {
              "type": "knowledge_point",
              "summary": "解释互斥、占有并等待、非抢占、循环等待。"
            },
            "label": "死锁的四个必要条件",
            "children": []
          },
          {
            "id": "kp-deadlock-strategies-brief",
            "data": {
              "type": "knowledge_point",
              "summary": "比较预防、避免、检测与恢复的基本思路。"
            },
            "label": "死锁预防、避免与检测",
            "children": []
          }
        ]
      },
      {
        "id": "mod-vm-brief",
        "data": {
          "type": "knowledge_module",
          "summary": "理解分页、缺页与页面置换算法。"
        },
        "label": "虚拟内存",
        "children": [
          {
            "id": "kp-paging-brief",
            "data": {
              "type": "knowledge_point",
              "summary": "解释页表、逻辑地址到物理地址的转换。"
            },
            "label": "分页与地址转换",
            "children": []
          },
          {
            "id": "kp-page-fault-brief",
            "data": {
              "type": "knowledge_point",
              "summary": "理解缺页处理流程与 FIFO、LRU 置换算法。"
            },
            "label": "缺页与页面置换",
            "children": []
          }
        ]
      }
    ]
