+def test_two_protocol_corrections_do_not_use_up_content_repair_budget(monkeypatch):
+    request = payload('quiz')
+    good = envelope()
+    bad = deepcopy(good)
+    bad['content']['questions'][0]['answer'] = 'B'  # structurally valid, factually wrong
+    rejected = indexed_review(bad, request)
+    rejected['question_checks'][0]['answer_matches'] = False
+    rejected['blocking_issues'] = ['程序执行工具，正确答案应为 A，当前 B 错误。']
+    repair = {k: v for k, v in good.items() if k != 'content'}
+    repair['edits'] = [{'path': ['questions', 0, 'answer'], 'before': 'B', 'after': 'A'}]
+    dangling = deepcopy(bad)
+    dangling['objective_bindings'][0]['locator']['question_id'] = 'missing'
+    replies = [bad['content'], dangling, bad, rejected, repair, indexed_review(good, request)]
+    requests, dispatched = [], []
+    original_call = ContentTools.call
+    def submit(self, name, arguments):
+        dispatched.append(deepcopy(arguments))
+        return original_call(self, name, arguments)
+    monkeypatch.setattr(ContentTools, 'call', submit)
+    def complete(http_request):
+        body = json.loads(http_request.content)
+        requests.append(body)
+        schema = body['tools'][0]['function']['parameters']
+        assert 'value' not in schema['properties']
+        assert schema['additionalProperties'] is False
+        if len(requests) == 5:
+            assert 'edits' in schema['required'] and 'content' not in schema['properties']
+        if len(requests) in (2, 3):
+            assert '未执行' in body['messages'][-1]['content']
+        return response(body, replies[len(requests) - 1])
+    model, ledger = gateway(complete, sdk_factory=DeepSeekHarness,
+                            context={'artifact_id': 'quiz', 'spec_digest': request.spec_digest})
+    artifact = ReviewedResourceGenerator(model).generate(request, job_id='j', config_snapshot_id='c')['artifacts'][0]
+    assert artifact['content'] == good['content']
+    assert verified_resource(artifact, 'quiz')
+    assert dispatched == replies[2:]
+    history = artifact['generation_state']['resource_review']['history']
+    assert [row['decision'] for row in history] == ['revise', 'pass']
+    assert [row['version'] for row in history] == [1, 2]
+    assert len(requests) == len(ledger.actions) == 6
+    assert [row['receipt']['model_response']['phase'] for row in ledger.actions] == [
+        'resource_write', 'resource_write', 'resource_write', 'resource_review', 'resource_repair', 'resource_review']
+
