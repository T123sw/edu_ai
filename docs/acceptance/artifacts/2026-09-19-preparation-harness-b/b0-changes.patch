+        (directory / 'SKILL.md').write_text(
+            f'---\nname: {name}\ndescription: Protocol fixture only\n---\n'
+            'Return the requested candidate using the mounted submission tool.\n')
+    monkeypatch.setattr(workflow_skills, 'SKILLS_ROOT', root)
