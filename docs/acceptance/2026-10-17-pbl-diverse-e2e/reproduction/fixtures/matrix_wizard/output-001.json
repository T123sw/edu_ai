{
  "schemaVersion": 1,
  "title": "本地两步报名向导",
  "goal": "用 React 实现一个纯本地两步报名向导：第 1 步填写姓名与年龄（姓名去空格后非空，年龄为 18 到 60 的整数），校验通过后才能进入第 2 步；第 2 步选择线上或线下并勾选同意条款，提交后显示姓名、年龄和参加方式；第 2 步可返回第 1 步且已填内容保留；成功后点击重新填写，所有字段与错误恢复空白初始状态。",
  "runtimeKind": "react_app",
  "editableFiles": [
    "/src/App.jsx",
    "/src/styles.css"
  ],
  "requirements": [
    {
      "id": "step1-validation",
      "description": "第 1 步填写姓名和年龄：姓名去掉首尾空格后必须非空；年龄必须是 18 到 60 之间的整数（拒绝 18.5、17、61 和空年龄）。校验不通过时停留在第 1 步并给出错误提示，通过后才能进入第 2 步。"
    },
    {
      "id": "step2-form",
      "description": "第 2 步可选择线上或线下参加方式，并勾选同意条款；两项都满足后点击提交，页面显示姓名、年龄和参加方式。"
    },
    {
      "id": "back-preserve",
      "description": "第 2 步可以返回第 1 步，返回后姓名和年龄的已填内容保留。"
    },
    {
      "id": "reset-blank",
      "description": "提交成功后点击重新填写，所有字段、选择、勾选和错误提示都恢复到空白初始状态，回到第 1 步。"
    }
  ],
  "steps": [
    {
      "id": "step1-basic-info",
      "title": "第 1 步：填写并校验姓名与年龄",
      "objective": "实现第 1 步表单，校验姓名非空与年龄为 18 到 60 的整数，通过后进入第 2 步占位页。",
      "dependsOn": [],
      "entryCondition": "从初始工程开始，页面只有空白骨架。",
      "deliverable": "页面显示第 1 步表单：姓名输入框、年龄输入框和“下一步”按钮。点击“下一步”时校验：姓名去空格后为空、年龄为空、年龄不是整数、年龄小于 18 或大于 60 都显示错误提示并停留在第 1 步；全部合法时进入第 2 步占位页。",
      "requirementIds": [
        "step1-validation"
      ],
      "focusFiles": [
        "/src/App.jsx",
        "/src/styles.css"
      ],
      "newCheckIds": [
        "check-step1-empty-name",
        "check-step1-age-not-integer",
        "check-step1-age-too-young",
        "check-step1-age-too-old",
        "check-step1-empty-age",
        "check-step1-valid-next"
      ]
    },
    {
      "id": "step2-submit",
      "title": "第 2 步：选择参加方式并提交显示结果",
      "objective": "实现第 2 步的参加方式选择、同意条款勾选与提交后显示结果。",
      "dependsOn": [
        "step1-basic-info"
      ],
      "entryCondition": "第 1 步已能校验并进入第 2 步占位页。",
      "deliverable": "第 2 步显示线上/线下单选、同意条款复选框和“提交”按钮。未选择参加方式或未勾选条款时提交不显示结果；两者都满足后点击提交，页面显示姓名、年龄和参加方式。",
      "requirementIds": [
        "step2-form"
      ],
      "focusFiles": [
        "/src/App.jsx",
        "/src/styles.css"
      ],
      "newCheckIds": [
        "check-step2-submit-online",
        "check-step2-submit-offline",
        "check-step2-blocked-without-consent"
      ]
    },
    {
      "id": "step3-back-and-reset",
      "title": "第 3 步：返回保留内容与重新填写",
      "objective": "实现第 2 步返回第 1 步保留已填内容，以及成功后重新填写恢复空白初始状态。",
      "dependsOn": [
        "step2-submit"
      ],
      "entryCondition": "第 2 步已能提交并显示结果。",
      "deliverable": "第 2 步提供“返回”按钮，点击回到第 1 步且姓名、年龄保留；提交成功后的结果区提供“重新填写”按钮，点击后回到第 1 步，姓名、年龄、参加方式、同意勾选和错误提示全部清空。",
      "requirementIds": [
        "back-preserve",
        "reset-blank"
      ],
      "focusFiles": [
        "/src/App.jsx",
        "/src/styles.css"
      ],
      "newCheckIds": [
        "check-step3-back-preserves",
        "check-step3-reset-blank"
      ]
    }
  ],
