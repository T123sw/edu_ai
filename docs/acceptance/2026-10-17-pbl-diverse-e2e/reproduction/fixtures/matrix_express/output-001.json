      ],
      "setup": "创建商品 {name:'葡萄',stock:10}，记录其 id。",
      "actions": [
        "POST /products/{id}/stock 发送 {delta:-4}",
        "GET /products"
      ],
      "expected": [
        "调整返回 200，stock 为 6",
