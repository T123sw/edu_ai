    {
      "id": "create-appears-in-list",
      "stepId": "create-product",
      "kind": "function_case",
      "requirementIds": [
        "create-product",
        "list-products",
        "json-persistence"
      ],
      "setup": "清空数据并启动服务。",
      "actions": [
        "POST /products 发送 {name:'香蕉',stock:5}",
        "GET /products"
      ],
      "expected": [
        "GET 返回 200",
        "列表包含 name 为 香蕉、stock 为 5 的商品"
      ],
      "requiredAssertions": [],
