{
  "schemaVersion": 1,
  "title": "FastAPI + SQLite 待办事项 REST API",
  "goal": "用 Python FastAPI 与 SQLite 实现一个真实启动的待办事项 REST API：POST /todos 创建（返回 201，空标题 422）、GET /todos 列表、PATCH /todos/{id} 修改完成状态、DELETE /todos/{id} 删除（不存在 ID 返回 404），并通过真实 HTTP 请求验收，服务重启后数据仍然保留。",
  "runtimeKind": "react_app",
  "editableFiles": [
    "/src/App.jsx",
    "/src/styles.css"
  ],
  "requirements": [
    {
      "id": "create-todo",
      "description": "POST /todos 接收 JSON 标题，创建待办并返回 201 与包含 id、title、completed=false 的响应体；标题为空或缺失时返回 422。"
    },
    {
      "id": "list-todos",
      "description": "GET /todos 返回 200 与当前全部待办的 JSON 数组，按创建顺序包含已创建的条目。"
    },
    {
      "id": "patch-todo",
      "description": "PATCH /todos/{id} 修改指定待办的完成状态并返回 200 与更新后的条目；ID 不存在时返回 404。"
    },
    {
      "id": "delete-todo",
      "description": "DELETE /todos/{id} 删除指定待办并返回成功状态；删除后该条目不再出现在列表中；ID 不存在时返回 404。"
    },
    {
      "id": "persistence",
      "description": "数据存储在 SQLite 文件中，服务进程重启后 GET /todos 仍能返回重启前创建的待办。"
    }
  ],
  "steps": [
    {
      "id": "setup-and-create",
      "title": "搭建服务并实现创建接口",
      "objective": "启动真实 FastAPI 服务，用 SQLite 建表，实现 POST /todos 创建待办并处理空标题 422。",
      "dependsOn": [],
      "entryCondition": "从空的初始工程开始，Python 环境可用，可安装 fastapi、uvicorn。",
      "deliverable": "一个能真实启动的 FastAPI 服务：POST /todos 用 JSON 标题创建待办，返回 201 和含 id、title、completed=false 的 JSON；标题为空或缺失返回 422；数据写入 SQLite 文件。",
      "requirementIds": [
        "create-todo"
      ],
      "focusFiles": [
        "/src/App.jsx",
        "/src/styles.css"
      ],
      "newCheckIds": [
        "create-returns-201",
        "create-empty-title-422"
      ]
    },
    {
      "id": "list-todos",
      "title": "实现列表接口",
      "objective": "实现 GET /todos 返回全部待办数组，验证创建后能读到。",
      "dependsOn": [
        "setup-and-create"
      ],
      "entryCondition": "上一步的创建接口已可用，SQLite 表已存在。",
      "deliverable": "GET /todos 返回 200 与 JSON 数组，包含此前通过 POST 创建的待办，字段与创建响应一致。",
      "requirementIds": [
        "create-todo",
        "list-todos"
      ],
      "focusFiles": [
        "/src/App.jsx",
        "/src/styles.css"
      ],
      "newCheckIds": [
        "list-returns-created"
      ]
    },
    {
      "id": "patch-and-delete",
      "title": "实现修改完成状态与删除接口",
      "objective": "实现 PATCH /todos/{id} 修改完成状态、DELETE /todos/{id} 删除，并对不存在 ID 返回 404。",
      "dependsOn": [
        "list-todos"
      ],
      "entryCondition": "创建与列表接口已可用，能通过 GET 确认条目存在。",
      "deliverable": "PATCH /todos/{id} 更新 completed 并返回更新后的条目；DELETE /todos/{id} 删除条目；两者对不存在 ID 返回 404；删除后条目不再出现在列表中。",
      "requirementIds": [
        "patch-todo",
        "delete-todo",
        "list-todos"
      ],
      "focusFiles": [
        "/src/App.jsx",
        "/src/styles.css"
      ],
      "newCheckIds": [
        "patch-completes-todo",
        "patch-missing-404",
        "delete-removes-todo",
        "delete-missing-404"
      ]
    },
    {
      "id": "persistence-restart",
      "title": "验证重启后数据保留",
      "objective": "确认 SQLite 持久化：重启服务进程后 GET /todos 仍返回重启前创建的待办。",
      "dependsOn": [
        "patch-and-delete"
      ],
      "entryCondition": "全部 CRUD 接口可用，数据写入 SQLite 文件而非内存。",
      "deliverable": "停止并重新启动服务后，GET /todos 仍返回重启前创建的待办及其完成状态。",
      "requirementIds": [
        "persistence",
        "list-todos"
      ],
      "focusFiles": [
        "/src/App.jsx",
        "/src/styles.css"
      ],
      "newCheckIds": [
        "restart-keeps-data"
      ]
    }
  ],
