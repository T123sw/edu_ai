      "checkId": "valid-rows-table"
    },
    {
      "requirementId": "parse-valid",
      "setup": "输入框为空",
      "action": "填入含空行与空姓名的行：张三,90 / 空行 / ,50 / 李四,80，点击分析",
      "expected": "空行与空姓名行被忽略，表格只有张三 90 与李四 80 两行",
      "checkId": "valid-rows-table"
    }
  ],
