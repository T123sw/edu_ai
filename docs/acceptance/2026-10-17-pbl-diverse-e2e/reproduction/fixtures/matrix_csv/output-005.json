      "expected": "缺少逗号行与超范围分数行分别以各自原始行号列出原因",
      "checkId": "invalid-lines-listed"
    },
    {
      "requirementId": "summary-stats",
      "setup": "输入 90、80 两条有效与一条非数字无效行",
      "action": "点击分析",
      "expected": "人数 2、平均分 85.00、最高分 90",
      "checkId": "stats-values"
    },
    {
      "requirementId": "parse-valid",
      "setup": "输入含 0 与 100 边界分数及重复姓名",
      "action": "点击分析",
      "expected": "0 与 100 均计入有效，人数 3、平均分 66.67、最高分 100",
      "checkId": "stats-values"
    },
    {
      "requirementId": "summary-stats",
      "setup": "输入全部为无效行",
      "action": "点击分析",
      "expected": "人数 0、平均分与最高分为 —",
      "checkId": "stats-empty"
    },
    {
      "requirementId": "summary-stats",
      "setup": "输入仅空行",
      "action": "点击分析",
      "expected": "人数 0、平均分与最高分为 —",
      "checkId": "stats-empty"
    }
  ],
