    {
      "id": "memory_context_management",
      "title": "记忆与上下文管理",
      "objectives": [
        {
          "objective_id": "memory_context_management:o1",
          "text": "能解释多步任务中上下文窗口被中间推理痕迹消耗的问题，以及为何早期步骤的推理在后期已无价值"
        },
        {
          "objective_id": "memory_context_management:o2",
          "text": "能说出至少两种上下文压缩策略（如 OpenAI run API 的截断策略、LlamaIndex 的 utility tools、MemGPT 的分层记忆）"
        },
        {
          "objective_id": "memory_context_management:o3",
          "text": "能在面试中说明何时该压缩或截断上下文的设计取舍"
        }
      ],
