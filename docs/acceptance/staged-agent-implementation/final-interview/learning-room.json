    {
      "id": "eval_observability",
      "title": "评估与可观测性",
      "objectives": [
        {
          "objective_id": "eval_observability:o1",
          "text": "能按 L1/L2/L3 分层说明各自应记录哪些日志字段（工具调用、任务状态、编排决策）"
        },
        {
          "objective_id": "eval_observability:o2",
          "text": "能解释从 L1 向上逐层排查的故障定位方法，而非笼统归因于幻觉"
        },
        {
          "objective_id": "eval_observability:o3",
          "text": "能在面试中说明可观测性如何支撑 Agent 的评估与迭代"
        }
      ],
