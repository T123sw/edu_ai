    {
      "id": "tool_calling_failure_recovery",
      "title": "工具调用与失败恢复",
      "objectives": [
        {
          "objective_id": "tool_calling_failure_recovery:o1",
          "text": "能描述工具调用协议：模型产出结构化 JSON 载荷（工具名+参数），应用接收、校验、执行并返回结果作为新上下文"
        },
        {
          "objective_id": "tool_calling_failure_recovery:o2",
          "text": "能区分瞬时故障与持久故障，并说明各自的处理策略（指数退避 vs 熔断器）"
        },
        {
          "objective_id": "tool_calling_failure_recovery:o3",
          "text": "能解释为什么模型应始终知道工具失败，而不是用幻觉内容填补缺口"
        }
      ],
