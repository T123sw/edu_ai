          "/styles.css": "body {\n  font-family: sans-serif;\n  -webkit-font-smoothing: auto;\n  -moz-font-smoothing: auto;\n  -moz-osx-font-smoothing: grayscale;\n  font-smoothing: auto;\n  text-rendering: optimizeLegibility;\n  font-smooth: always;\n  -webkit-tap-highlight-color: transparent;\n  -webkit-touch-callout: none;\n}\n\nh1 {\n  font-size: 1.5rem;\n}\n\n.converter {\n  box-sizing: border-box;\n  max-width: 100%;\n  padding: 16px;\n  display: flex;\n  flex-direction: column;\n  gap: 12px;\n}\n\n.converter label {\n  display: flex;\n  flex-direction: column;\n  gap: 6px;\n  min-width: 0;\n}\n\n.converter input {\n  box-sizing: border-box;\n  width: 100%;\n  max-width: 100%;\n  padding: 8px;\n  font-size: 1rem;\n}\n\n.converter button {\n  box-sizing: border-box;\n  padding: 8px 16px;\n  font-size: 1rem;\n  cursor: pointer;\n  align-self: flex-start;\n}\n\n.result {\n  font-size: 1.25rem;\n  min-height: 1.5em;\n  word-break: break-word;\n}\n",
          "/index.js": "import \"./styles.css\";\nimport { celsiusToFahrenheit } from \"./convert.js\";\n\ndocument.getElementById(\"app\").innerHTML = `\n<div class=\"converter\">\n  <h1>摄氏转华氏换算器</h1>\n  <label>\n    摄氏温度\n    <input type=\"number\" data-testid=\"celsius-input\" placeholder=\"输入摄氏温度\" />\n  </label>\n  <button type=\"button\" data-testid=\"convert-button\">换算</button>\n  <div class=\"result\" data-testid=\"result\"></div>\n</div>\n`;\n\nconst input = document.querySelector('[data-testid=\"celsius-input\"]');\nconst convertButton = document.querySelector('[data-testid=\"convert-button\"]');\nconst result = document.querySelector('[data-testid=\"result\"]');\n\nconvertButton.addEventListener(\"click\", () => {\n  const raw = input.value.trim();\n  if (raw === \"\") {\n    result.textContent = \"\";\n    return;\n  }\n  const celsius = Number(raw);\n  if (Number.isNaN(celsius)) {\n    result.textContent = \"\";\n    return;\n  }\n  result.textContent = String(celsiusToFahrenheit(celsius));\n});\n",
          "/convert.js": "export function celsiusToFahrenheit(celsius) {\n  return (celsius * 9) / 5 + 32;\n}\n"
        }
