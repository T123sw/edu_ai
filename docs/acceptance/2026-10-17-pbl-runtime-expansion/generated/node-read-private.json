          "/index.js": "const express = require('express');\n\nconst app = express();\n\napp.use(require('./routes/health'));\napp.use(require('./routes/square'));\n\napp.listen(3000, () => {\n  console.log('Server running at http://localhost:3000/');\n});\n",
          "/routes/health.js": "const express = require('express');\n\nconst router = express.Router();\n\nrouter.get('/health', (req, res) => {\n  res.json({ status: 'ok' });\n});\n\nmodule.exports = router;\n",
          "/routes/square.js": "const express = require('express');\nconst square = require('../lib/square');\n\nconst router = express.Router();\n\nrouter.get('/square', (req, res) => {\n  const raw = req.query.n;\n\n  if (raw === undefined || raw === '') {\n    return res.status(400).json({ error: 'invalid n' });\n  }\n\n  const n = Number(raw);\n\n  if (!Number.isFinite(n)) {\n    return res.status(400).json({ error: 'invalid n' });\n  }\n\n  res.json({ result: square(n) });\n});\n\nmodule.exports = router;\n",
          "/lib/square.js": "function square(n) {\n  return n * n;\n}\n\nmodule.exports = square;\n"
        }
