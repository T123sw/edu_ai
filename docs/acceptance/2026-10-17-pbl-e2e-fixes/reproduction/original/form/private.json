          "referenceFiles": {
            "/src/App.jsx": "import React, { useState } from 'react';\nimport './styles.css';\n\nexport default function App() {\n  const [name, setName] = useState('');\n  const [message, setMessage] = useState('');\n\n  function handleChange(event) {\n    setName(event.target.value);\n    setMessage('');\n  }\n\n  function handleSubmit() {\n    const trimmed = name.trim();\n    if (trimmed === '') {\n      setMessage('请输入姓名');\n    } else {\n      setMessage('报名成功：' + trimmed);\n    }\n  }\n\n  return (\n    <main className=\"signup\">\n      <h1>活动报名</h1>\n      <div className=\"field\">\n        <label htmlFor=\"name\">姓名</label>\n        <input\n          id=\"name\"\n          data-testid=\"name-input\"\n          type=\"text\"\n          value={name}\n          onChange={handleChange}\n          placeholder=\"请输入姓名\"\n        />\n      </div>\n      <button data-testid=\"submit-button\" type=\"button\" onClick={handleSubmit}>\n        报名\n      </button>\n      {message && (\n        <p data-testid=\"message\" className=\"message\">\n          {message}\n        </p>\n      )}\n    </main>\n  );\n}\n",
            "/src/styles.css": "body { margin: 0; font-family: sans-serif; }\nmain { padding: 24px; }\n\n.signup {\n  max-width: 360px;\n}\n\n.field {\n  display: flex;\n  flex-direction: column;\n  gap: 6px;\n  margin-bottom: 12px;\n}\n\ninput {\n  padding: 8px;\n  font-size: 16px;\n}\n\nbutton {\n  padding: 8px 16px;\n  font-size: 16px;\n  cursor: pointer;\n}\n\n.message {\n  margin-top: 12px;\n  font-size: 16px;\n}\n"
          }
        },
