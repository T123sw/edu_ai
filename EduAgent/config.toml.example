[api_key]
# Standard DeepSeek API key. Leave empty if you use remote_model_api_key.
deepseek_api_key=''

# OpenAI-compatible custom endpoint key. This maps to REMOTE_MODEL_API_KEY.
remote_model_api_key='sk-your-remote-model-api-key'

[model]
# Provider type: deepseek or openai-compatible.
llm_supply='deepseek'

# Model name. This maps to LLM_MODEL.
llm_model='deepseek-chat'

# Public/default model id used by UI or orchestration code.
default_llm_model_id='deepseek-chat'

temperature=0.2
max_tokens=7000

[api_base]
# OpenAI-compatible base URL. This maps to REMOTE_MODEL_API_BASE.
remote_model_api_base='https://api.deepseek.com/v1'
