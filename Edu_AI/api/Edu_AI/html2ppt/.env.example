# html2ppt service environment example
PPT_SERVICE_PORT=46080
PPT_DATA_DIR=./data
PPT_WORKER_CONCURRENCY=1

# Chrome / Chromium. Leave empty to let the service try common Chrome,
# Edge, and Chromium paths for the current OS.
PPT_CHROME_PATH=
PPT_CHROME_ARGS=[]
PPT_CHROME_TIMEOUT_MS=120000
PPT_CHROME_VIRTUAL_TIME_BUDGET_MS=1000

# ffmpeg is used by media/video handling in the latest upstream service.
PPT_FFMPEG_PATH=ffmpeg

# Agent command used by PPT generation jobs.
PPT_CLAUDE_CMD=claude
PPT_CLAUDE_ARGS=["-p","--output-format","text","--permission-mode","bypassPermissions"]
PPT_DEFAULT_THEME_ID=heu_academic_elegant
