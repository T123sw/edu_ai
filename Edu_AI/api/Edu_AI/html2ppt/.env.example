# PPT 服务监听端口
PPT_SERVICE_PORT=46080

# 产物与任务数据目录
PPT_DATA_DIR=./data

# 队列并发数
PPT_WORKER_CONCURRENCY=1

# Chrome / Chromium 可执行文件路径
# macOS 示例：
# PPT_CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# Linux 示例：
# PPT_CHROME_PATH=/usr/bin/google-chrome
PPT_CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome

# Chrome 额外参数
# 推荐写成 JSON 数组；Linux / Docker 常见示例：
# PPT_CHROME_ARGS=["--no-sandbox","--disable-dev-shm-usage"]
PPT_CHROME_ARGS=[]

# Claude Code CLI 命令与参数
PPT_CLAUDE_CMD=claude
PPT_CLAUDE_ARGS=["-p","--output-format","text","--permission-mode","bypassPermissions"]
PPT_CLAUDE_TIMEOUT_MS=1800000

# 默认主题 ID
PPT_DEFAULT_THEME_ID=heu_academic_elegant
