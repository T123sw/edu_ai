# 服务器API地址（替换为您的服务器IP）
REMOTE_MODEL_API_BASE=http://192.168.1.51:8001/v1 

# 模型名称
LLM_MODEL=Qwen2-7B

# 使用OpenAI兼容模式


# 嵌入模型配置（使用本地Ollama或远程服务）

   EMBEDDING_BACKEND=ollama
   OLLAMA_BASE_URL=http://localhost:11434
   EMBEDDING_API_BASE=http://localhost:11434
   EMBEDDING_MODEL=nomic-embed-text   # 和你刚才 curl 测试的模型名一致
# Baidu speech transcription
BAIDU_SPEECH_APP_ID=
BAIDU_SPEECH_API_KEY=
BAIDU_SPEECH_SECRET_KEY=
BAIDU_SPEECH_SAMPLE_RATE=16000
BAIDU_SPEECH_DEV_PID=1537

# AI Lecturer offline full-video generation.
# Set to 0/false/off/no to reserve CPU/GPU for the real-time teaching path.
AI_LECTURER_OFFLINE_ENABLED=1

# ===== Web 检索层（Phase 1.5 前置：Bocha 搜索 + Tavily Extract 全文）=====
# 搜索源（找 URL + 摘要），课件/RAG 常规档；替换旧 deepsearch+SearxNG
WEB_SEARCH_PROVIDER=bocha
BOCHA_API_KEY=                       # 博查 open platform 申请
BOCHA_BASE_URL=https://api.bocha.cn
WEB_SEARCH_DEFAULT_COUNT=10
WEB_SEARCH_FRESHNESS=noLimit         # noLimit|day|week|month|year
# 全文抽取（深度研究档，按 URL 抽全文 markdown）；替换旧自建爬虫
WEB_EXTRACT_PROVIDER=tavily
TAVILY_API_KEY=                      # tavily.com 申请
TAVILY_BASE_URL=https://api.tavily.com
WEB_EXTRACT_DEPTH=basic              # basic|advanced
WEB_EXTRACT_MAX_URLS=20              # Tavily Extract 单次上限 20
WEB_EXTRACT_TIMEOUT_S=30
