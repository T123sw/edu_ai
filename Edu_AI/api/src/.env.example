# Remote model API
REMOTE_MODEL_API_BASE=http://192.168.1.51:8001/v1
LLM_MODEL=Qwen2-7B

# PostgreSQL is the primary structured-data store after migration.
DATABASE_URL=

# Use "shadow" only for reconciliation, or "json" for an explicit rollback.
USER_PERSISTENCE_MODE=postgres
COURSE_PERSISTENCE_MODE=postgres
COURSE_MEMBERSHIP_PERSISTENCE_MODE=postgres
CONVERSATION_PERSISTENCE_MODE=postgres
JOB_PERSISTENCE_MODE=postgres
MATERIAL_PERSISTENCE_MODE=postgres
SHADOW_FAILURE_JOURNAL=storage/database_shadow_failures.jsonl

# Embeddings
EMBEDDING_BACKEND=ollama
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_API_BASE=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text

# Baidu speech transcription
BAIDU_SPEECH_APP_ID=
BAIDU_SPEECH_API_KEY=
BAIDU_SPEECH_SECRET_KEY=
BAIDU_SPEECH_SAMPLE_RATE=16000
BAIDU_SPEECH_DEV_PID=1537

# Web search layer: Bocha Search + Tavily Extract.
WEB_SEARCH_PROVIDER=bocha
BOCHA_API_KEY=
BOCHA_BASE_URL=https://api.bocha.cn
WEB_SEARCH_DEFAULT_COUNT=10
WEB_SEARCH_FRESHNESS=noLimit
BOCHA_SEARCH_RECALL_COUNT=50
BOCHA_RERANK_ENABLED=true
BOCHA_RERANK_MODEL=gte-rerank
BOCHA_RERANK_TIMEOUT_S=15

WEB_EXTRACT_PROVIDER=tavily
TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com
WEB_EXTRACT_DEPTH_FULL=advanced
WEB_EXTRACT_MAX_URLS=20
WEB_EXTRACT_TIMEOUT_S=60
DEEPSEARCH_RESULT_CONTENT_MAX_CHARS=50000
DEEPSEARCH_MAX_INLINE_IMAGES=8

# Image search uses Bocha too; leave empty to disable image_search.
IMAGE_SEARCH_PROVIDER=bocha
IMAGE_SEARCH_TIMEOUT_S=8
BOCHA_IMAGE_SEARCH_RECALL_COUNT=50

# OpenMAIC sidecar (vendored at edu_ai/openmaic-sidecar/, SPEC-01/07).
# Local dev default assumes `pnpm dev` running on :3000; in docker-compose
# use the service name (e.g. http://openmaic-sidecar:3000).
OPENMAIC_BASE_URL=http://localhost:3000

# Phase 5 OpenMAIC classroom video export. The backend launches the frontend
# render route with Playwright, then composes MP4/SRT/timeline artifacts.
CLASSROOM_VIDEO_FRONTEND_URL=http://127.0.0.1:5173
CLASSROOM_VIDEO_NODE=node
CLASSROOM_VIDEO_FFMPEG=ffmpeg
