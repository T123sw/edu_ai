# ====== 1. 生成大模型配置 (DeepSeek) ======
LLM_MODEL=deepseek-chat
# 请在此处填入你的 DeepSeek API Key
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ====== 2. 向量大模型配置 (BGE M3) ======
EMBEDDING_BACKEND=openai
EMBEDDING_MODEL=BAAI/bge-m3
# 请在此处填入你的 Embedding API Key (如 SiliconFlow)
EMBEDDING_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 若使用国内中转站，请修改下方地址并务必保留 /v1 后缀
EMBEDDING_API_BASE=https://api.siliconflow.cn/v1

# ====== 3. RAG 引擎高级配置 ======
# 开启混合检索的 BM25 和重写功能
RAG_ENABLE_QUERY_REWRITE=1
# 开启增强检索模式（HyDE + 多路召回 + RRF 融合）
RAG_ENABLE_ENHANCED_RETRIEVAL=1

# HyDE 相关配置
RAG_HYDE_WEIGHT=0.5
RAG_USE_RRF=1
RAG_RRF_K=60

# ====== 4. Reranker 重排模型配置 ======
RAG_ENABLE_RERANKER=1
RERANKER_API_BASE=https://api.vectorengine.ai/v1
RERANKER_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_TIMEOUT=30

# ====== 5. Embedding 高级配置 ======
EMBEDDING_BATCH_SIZE=64
EMBEDDING_MAX_WORKERS=4
EMBEDDING_TIMEOUT_SEC=120
EMBEDDING_MAX_RETRIES=3

# ====== 6. 图片处理相关配置 ======
# 是否启用图片向量（1:启用，0:禁用）。注意：BGE-M3 主要是文本模型，建议设为 0
RAG_ENABLE_IMAGE_EMBEDDING=0
RAG_IMAGE_EMBED_FALLBACK_TO_TEXT=1

# ====== 7. 文档解析相关配置 ======
TEMP_DIR=./temp
DOCUMENTS_ROOT=./storage/documents
VECTOR_DB_PATH=./knowledge_base/chroma_db
DOCUMENT_INDEX_PATH=./knowledge_base/document_index.json

# MinerU PDF 解析配置
# 是否启用 MinerU 解析（1:启用，0:禁用，默认 1）
RAG_USE_MINERU=1
# MinerU 每个分片的页数（范围 10-30，默认 20）
RAG_MINERU_PAGES_PER_CHUNK=20
# MinerU 最大并行工作线程数（默认 4）
RAG_MINERU_MAX_WORKERS=4

# ====== 8. 性能优化配置 ======
BM25_MAX_DOCS=10000
BM25_REBUILD_INTERVAL_SEC=300
