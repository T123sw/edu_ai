from dataclasses import dataclass
from typing import Literal, Optional, Dict, Any
import hashlib

Path = Literal["fast", "agentic"]

@dataclass
class RouteDecision:
    path: Path
    needs_rag: bool
    needs_tools: bool
    confidence: float
    reason: str

def rule_gate(text: str) -> Optional[RouteDecision]:
    t = text.strip()
    if len(t) <= 20 and any(k in t for k in ["你好", "谢谢", "哈哈", "在吗"]):
        return RouteDecision("fast", False, False, 0.95, "smalltalk rule")
    if any(k in t for k in ["润色", "改写", "纠错"]) and len(t) <= 400:
        return RouteDecision("fast", False, False, 0.85, "light edit rule")
    return None

def route_key(user_id: str, text: str) -> str:
    h = hashlib.sha256(text.encode("utf-8")).hexdigest()[:12]
    return f"route:{user_id}:{h}"

def llm_router(text: str, context_brief: Dict[str, Any]) -> RouteDecision:
    """
    用小模型/中模型输出结构化字段（建议 JSON Schema）。
    可用：训练路由器（RouteLLM 思路），或用通用小模型做分类。
    """
    # 返回示例
    return RouteDecision("agentic", True, True, 0.78, "need retrieval + tool")

def router(user_id: str, text: str, context_brief: Dict[str, Any],
           cache_get, cache_set, ttl_s=60) -> RouteDecision:
    r = rule_gate(text)
    if r:
        return r

    k = route_key(user_id, text)
    cached = cache_get(k)
    if cached:
        return cached

    r = llm_router(text, context_brief)

    # 只缓存高置信快路径，避免“错路由固化”
    if r.path == "fast" and r.confidence >= 0.9:
        cache_set(k, r, ttl_s)
    return r
离线路由训练（思路，非完整实现）
用日志回放构造偏好/标签：例如“快路径模型输出被用户接受”视为弱模型可用；“用户点了‘加强/改错/引用资料’或触发教师导出工作流”视为需要强模型/慢路径。然后训练一个轻量分类器（可用 embedding + 线性模型，或小 LLM 微调），并用离线评测校准阈值。这与 RouteLLM 强调的“用偏好数据训练 router”一致。

