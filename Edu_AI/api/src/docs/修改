from cachetools import TTLCache
import numpy as np

# 1) embedding cache：避免重复算 embedding
emb_cache = TTLCache(maxsize=50_000, ttl=3600)

# 2) retrieval cache：Query embedding hash -> topK doc ids
retr_cache = TTLCache(maxsize=200_000, ttl=300)

# 3) snippet cache：doc chunk -> curated summary
snippet_cache = TTLCache(maxsize=500_000, ttl=86400)

def embed(text: str) -> np.ndarray:
    if text in emb_cache:
        return emb_cache[text]
    v = embedding_model(text)      # 自托管或供应商 embedding
    emb_cache[text] = v
    return v

def retrieve_topk(text: str, k=8):
    v = embed(text)
    key = hash(v.tobytes())  # 示例：工程上建议用稳定 hash
    if key in retr_cache:
        return retr_cache[key]

    doc_ids = vector_db_search(v, topk=k)
    retr_cache[key] = doc_ids
    return doc_ids

def curated_snippet(doc_id: str) -> str:
    if doc_id in snippet_cache:
        return snippet_cache[doc_id]
    raw = load_doc_chunk(doc_id)
    summary = small_model_summarize(raw)  # 也可离线批处理生成
