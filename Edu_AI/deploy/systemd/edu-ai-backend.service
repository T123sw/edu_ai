[Unit]
Description=Edu-AI FastAPI Backend
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/srv/edu-ai/backend/api/Edu_AI
EnvironmentFile=/srv/edu-ai/backend/api/Edu_AI/.env
ExecStart=/srv/edu-ai/backend/api/Edu_AI/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
