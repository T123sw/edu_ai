# Edu-AI unified environment template
# Copy this file to .env at the repository root. Never commit real secrets.

# Frontend production build: Nginx removes the /backend prefix before proxying.
VITE_API_BASE_URL=/backend

# FastAPI
APP_NAME="Edu-AI API"
API_PREFIX=/api
CORS_ALLOW_ORIGINS=*
DURABLE_JOB_WORKERS=3
# Additional reserved workers for preparation scheduling; never run long generation jobs.
DURABLE_JOB_CONTROL_WORKERS=2
# Reports/quizzes only; supplementary worker uses --light-workers 0.
DURABLE_JOB_LIGHT_WORKERS=2
# Independent resources submitted simultaneously per course (1-32).
COURSE_PREPARATION_RESOURCE_CONCURRENCY=8
# Reserve resource capacity for reports/quizzes while long videos run.
COURSE_PREPARATION_VIDEO_CONCURRENCY=8
# Video target is separate from course/node learning time; explicit user input wins.
HYPERFRAMES_VIDEO_TARGET_MINUTES=5

# PostgreSQL (URL-encode special characters in the password)
DATABASE_URL=postgresql+psycopg://edu_ai:replace_with_a_url_encoded_password@127.0.0.1:5432/edu_ai
PERSISTENCE_PROFILE=database
USER_PERSISTENCE_MODE=postgres
COURSE_PERSISTENCE_MODE=postgres
COURSE_MEMBERSHIP_PERSISTENCE_MODE=postgres
CONVERSATION_PERSISTENCE_MODE=postgres
# Enable only after migration 20260917_0023 and draining legacy learning Q&A workers.
# Once enabled and sessions imported, rollback must retain the database read path.
LEARNING_SESSION_V1_ENABLED=false
JOB_PERSISTENCE_MODE=postgres
MATERIAL_PERSISTENCE_MODE=postgres
KNOWLEDGE_PERSISTENCE_MODE=postgres
APP_STATE_PERSISTENCE_MODE=postgres
LEARNING_PERSISTENCE_MODE=postgres
TASK_PERSISTENCE_MODE=postgres

# Runtime data lives outside the Git checkout.
STORAGE_ROOT=/data/edu_ai/storage
COURSE_STORAGE_ROOT=/data/edu_ai/course_data
TEMP_DIR=/data/edu_ai/tmp
SHADOW_FAILURE_JOURNAL=/data/edu_ai/storage/database_shadow_failures.jsonl

# Planner / deep-answer / vision providers
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
LOGIC_MODEL_MINI=openai/gpt-5.4-mini
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_API_KEY=
ANSWER_LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
ANSWER_LLM_API_KEY=
ANSWER_LLM_MODEL=qwen3.5-plus
VISION_MODEL_ID=qwen3.5-plus

# Legacy-compatible model aliases still read by a few backend adapters.
REMOTE_MODEL_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
REMOTE_MODEL_API_KEY=
LLM_MODEL=qwen3.5-plus

# Embeddings
EMBEDDING_BACKEND=openai
EMBEDDING_API_BASE=https://api.relayrouter.ai/v1
EMBEDDING_MODEL=gemini-embedding-2-preview
EMBEDDING_TIMEOUT_SEC=120

# Web and image search; leave provider/key empty to disable.
WEB_SEARCH_PROVIDER=bocha
BOCHA_API_KEY=
BOCHA_BASE_URL=https://api.bocha.cn
WEB_EXTRACT_PROVIDER=tavily
TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com
IMAGE_SEARCH_PROVIDER=bocha

# Baidu speech transcription; leave empty to disable.
BAIDU_SPEECH_APP_ID=
BAIDU_SPEECH_API_KEY=
BAIDU_SPEECH_SECRET_KEY=
BAIDU_SPEECH_SAMPLE_RATE=16000
BAIDU_SPEECH_DEV_PID=1537

# TTS_LOCAL_ONLY=true: 本地 Qwen3-TTS；false: 下方远程 Qwen-Audio-TTS。
# 两种模式均由本文件控制，不受页面历史配置或旧任务快照覆盖。
TTS_LOCAL_ONLY=true
TTS_PROVIDER_NAME=local-qwen-tts
TTS_API_BASE=http://127.0.0.1:8188/v1
TTS_API_KEY=
TTS_MODEL=qwen3-tts
TTS_VOICE=vivian
TTS_TIMEOUT_SECONDS=120
TTS_SPEED=1.0
TTS_RESPONSE_FORMAT=mp3

# 远程配音：TTS_LOCAL_ONLY=false 时只读取本组；true 时读取上面的本地 TTS_* 配置。
# 使用北京地域百炼 API Key；也可将地址换成业务空间专属域名的 /api/v1。
# 官方协议：https://help.aliyun.com/zh/model-studio/qwen-audio-tts-http-api
TTS_REMOTE_API_BASE=https://dashscope.aliyuncs.com/api/v1
TTS_REMOTE_API_KEY=
TTS_REMOTE_MODEL=qwen-audio-3.1-tts-flash
# 3.1 音色区分大小写，不能沿用本地 vivian/serena。
TTS_REMOTE_VOICE=longanhuan_v3.1
# 语速/音调范围 0.5~2.0；音量 0~100。
TTS_REMOTE_SPEED=1.0
TTS_REMOTE_PITCH=1.0
TTS_REMOTE_VOLUME=50
TTS_REMOTE_LANGUAGE=zh
TTS_REMOTE_SAMPLE_RATE=24000
TTS_REMOTE_RESPONSE_FORMAT=mp3
TTS_REMOTE_TIMEOUT_SECONDS=120
# 可选：自然、清晰的教师讲解语气。留空则采用模型默认表达。
TTS_REMOTE_INSTRUCTIONS=

# 以下仅供本地 Qwen3-TTS 服务进程使用。
QWEN_TTS_MODEL=/home/zxqs_ep/data/models/qwen3-tts
QWEN_TTS_DEVICE=cuda:0
# Batch independent complete utterances; never split a chapter into fragments.
QWEN_TTS_REQUEST_BATCH_SIZE=4
QWEN_TTS_BATCH_MAX_CHARS=1600
QWEN_TTS_MAX_PENDING=64
PODCAST_AUDIO_CONCURRENCY=8
HYPERFRAMES_AUDIO_CONCURRENCY=8
# Native frame authors per video / across all processes on this host; full upstream packets retained.
HYPERFRAMES_FRAME_CONCURRENCY=6
HYPERFRAMES_GLOBAL_FRAME_CONCURRENCY=16
# Original renderer workers; set 1 to explicitly use the low-memory profile.
HYPERFRAMES_RENDER_WORKERS=4
HF_CAPTURE_PARALLEL_STREAM=true
HYPERFRAMES_RENDER_CONCURRENCY=4
HYPERFRAMES_RENDER_MIN_FREE_MB=2048
# All processes must share this directory (default: /tmp/edu-ai-stage-limits-UID).
# EDU_STAGE_LIMIT_DIR=/shared/local/edu-ai-stage-limits
TTS_REMOTE_CONCURRENCY=8
TTS_REMOTE_REQUESTS_PER_SECOND=4
# Set the same non-secret group for multiple API keys sharing one provider quota.
# TTS_REMOTE_LIMIT_GROUP=teaching-account

# Classroom video export uses the Nginx-served production frontend.
CLASSROOM_VIDEO_FRONTEND_URL=http://127.0.0.1
CLASSROOM_VIDEO_NODE=node
CLASSROOM_VIDEO_FFMPEG=ffmpeg

# Agent Memory V2
AGENT_MEMORY_ENABLED=true
# 普通文本对话与报告接入 DeepSeek Harness；其他显式资源入口保留原路径。
USE_DEEPSEEK_HARNESS=false
DSH_MODEL=deepseek-v4-flash
DSH_TIMEOUT_SECONDS=180
AGENT_MEMORY_LANGMEM_ENABLED=true
AGENT_MEMORY_LANGMEM_SHADOW_MODE=false
AGENT_MEMORY_LANGMEM_BACKGROUND=true
AGENT_MEMORY_LANGMEM_TIMEOUT_MS=12000
AGENT_MEMORY_LANGMEM_MAX_CANDIDATES=4
AGENT_MEMORY_EMBEDDING_ENABLED=false

# Filename-first RAG routing; disabling retains authorized-scope retrieval.
RAG_DOCUMENT_SELECTION_ENABLED=1
RAG_DOCUMENT_SELECTION_LIMIT=5
RAG_DOCUMENT_SELECTION_MAX_CANDIDATES=100
RAG_DOCUMENT_SELECTION_MAX_CHARS=12000
RAG_DOCUMENT_SELECTION_TIMEOUT=8
EMBEDDING_API_KEY=your_relayrouter_api_key

# 所有服务端任务访问此 DeepSeek 地址时都以 DEEPSEEK_API_KEY 为主密钥；
# ANSWER_LLM_API_KEY 等角色别名不会覆盖它。仅当主密钥返回 HTTP 402 时，
# 当前请求才会用 DEEPSEEK_API_KEY_BACKUP 重试一次。
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_API_KEY=
DEEPSEEK_API_KEY_BACKUP=

# 课程准备 Agent：独立研究/学习路径阶段。先执行迁移 20260917_0025 再启用。
# 需要 DATABASE_URL、用户可用的 LLM 配置，以及 TAVILY_API_KEY（搜索与正文读取）。
# 成功仅表示学习路径通过审阅，不代表课程资源已生成。
COURSE_RESEARCH_ENABLED=false

# P2: migrate through 20260917_0024 before enabling. Versioned facts replace legacy completion/self-assessment writes.
# Keep disabled until legacy unversioned records have been reviewed; P6 owns migration.
LEARNING_PROGRESS_V1_ENABLED=false
# 课程准备不设置累计调用/token/费用/整课时限或内容篇幅上限。
# 不用 UTF-8 字节数推算 token 来提前拒绝请求；真实上下文容量由模型服务处理。
# 输出采用已知供应商容量，未知供应商省略 max_tokens，使用其默认值。
# COURSE_RESEARCH_CONTEXT_TOKENS 已弃用。
# 以下两个设置仅供历史有界研究流程兼容；生产课程准备 retry_only 策略不读取它们。
COURSE_RESEARCH_VIEW_SOFT_BYTES=48000
COURSE_RESEARCH_VIEW_MAX_BYTES=96000
# These projection quotas apply only to legacy bounded tasks. Retry-only preparation
# uses the detected model window and retrieves original evidence through read tools.

# P3 durable learning answers. Requires session persistence and migration 20260917_0026.
LEARNING_AGENT_V1_ENABLED=false

# Complete preparation pipeline; apply the merged migration chain through 20260918_0036 first.
COURSE_PREPARATION_ENABLED=false

# Retained learning Agent rollout settings. P4 requires 0027; P5 requires 0028.
LEARNING_ENRICHMENT_V1_ENABLED=false
LEARNING_PREPARATION_V1_ENABLED=false
# P6: keep enabled during model-feature rollback so migrated facts remain authoritative.
LEARNING_SCOPED_ROLLOUT=false

# Native HyperFrames 0.8.168 uses the pinned local CLI, Chromium and ffmpeg.
# Projects and audio cache live under COURSE_STORAGE_ROOT/hyperframes.
# Full upstream source is retained in vendor/hyperframes.
# No separate classroom HTTP process is required.
